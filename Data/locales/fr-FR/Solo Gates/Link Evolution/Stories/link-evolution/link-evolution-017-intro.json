    },
    {
      "char": "carlycarmine",
      "pos": "RIGHT",
      "image": "dark_smile",
      "text": "Je t'attendais, Jackie!"
    },
    {
      "char": "jackatlas",
      "pos": "LEFT",
      "image": "discouragement",
      "text": "Non ... Tu ne peux pas être un Pactisant des Ténèbres..."
    },
    {
      "char": "carlycarmine",
      "pos": "",
      "image": "dark_smile",
      "text": "Mais je le suis."
    },
    {
      "char": "jackatlas",
      "pos": "",
      "image": "discouragement",
      "text": "Carly, qui t'a fait ça?"
    },
    {
      "char": "carlycarmine",
      "pos": "",
      "image": "dark_bittersleep",
      "text": "Qui, Jack? Tu dois être en train de plaisanter ... la réponse est tellement évidente."
    },
    {
      "char": "carlycarmine",
      "pos": "",
      "image": "dark_anger",
      "text": "Tu es le seul responsable!"
    },
    {
      "char": "jackatlas",
      "pos": "",
      "image": "surprise",
      "text": "Non, tu te trompes. Je suis celui qui essaie de te sauver!"
    },
    {
      "char": "carlycarmine",
      "pos": "",
      "image": "dark_smile",
      "text": "S'il te plaît. Tu as choisi de me couper la parole parce que tu pensais que j'étais un des paparazzi."
    },
    {
      "char": "jackatlas",
      "pos": "",
      "image": "surprise",
      "text": "Ce n'est pas vrai!"
    },
    {
      "char": "jackatlas",
      "pos": "",
      "image": "anger",
      "text": "Je t'ai gardé à distance parce que je ne voulais pas que tu te blesses!"
    },
    {
      "char": "carlycarmine",
      "pos": "",
      "image": "dark_anger",
      "text": "Eh bien, tu as échoué. Et maintenant c'est à mon tour de me venger!"
    },
    {
      "char": "carlycarmine",
      "pos": "",
      "image": "dark_anger",
      "text": "Ah, quelle ironie. Avant, je te courais après et m'accrochais au moindre de tes mots. Mais maintenant, la boucle est bouclée."
    },
    {
      "char": "carlycarmine",
      "pos": "",
      "image": "dark_smile",
      "text": "C'est toi qui est maintenant le désespéré."
    },
    {
      "char": "jackatlas",
      "pos": "",
      "image": "anger",
      "text": "C'est vrai. Désespéré d'avoir l'ancienne Carly de retour. Et il n'y a pas moyen que cela ne se produise pas!"
    }
  ]
}
