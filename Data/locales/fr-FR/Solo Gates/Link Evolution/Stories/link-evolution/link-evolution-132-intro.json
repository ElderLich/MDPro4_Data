    {
      "char": "bronkstone",
      "pos": "LEFT",
      "image": "discouragement",
      "text": ""
    },
    {
      "char": "yumatsukumo",
      "pos": "",
      "image": "surprise",
      "text": "C'est vrai?"
    },
    {
      "char": "bronkstone",
      "pos": "LEFT",
      "image": "discouragement",
      "text": "Oui. Mais j'étais obligé de le faire! Il m'a appelé une grosse poule."
