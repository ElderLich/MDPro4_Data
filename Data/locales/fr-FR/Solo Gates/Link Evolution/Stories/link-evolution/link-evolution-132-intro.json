    {
      "char": "bronkstone",
      "pos": "NONE",
      "image": "neutral",
      "text": ""
    },
    {
      "char": "reginaldkastle",
      "pos": "RIGHT",
      "image": "",
      "text": ""
    },
    {
      "char": "yumatsukumo",
      "pos": "",
      "image": "anger",
      "text": "Très bien alors! Si tu défies mon ami, alors je vais te défier!"
    },
    {
      "char": "reginaldkastle",
      "pos": "",
      "image": "smile",
      "text": "Si tu me bats, je vais te rendre ce deck. Mais si je gagne, Yuma - je prendrai ton deck."
