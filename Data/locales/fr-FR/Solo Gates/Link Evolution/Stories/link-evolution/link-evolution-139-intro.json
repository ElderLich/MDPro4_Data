      "char": "harttenjo",
      "pos": "CENTER",
      "image": "neutral",
      "text": ""
    },
    {
      "char": "quinton",
      "pos": "",
      "image": "",
      "text": "Je suis ici pour vous aider. N'est-ce pas, Hart?"
