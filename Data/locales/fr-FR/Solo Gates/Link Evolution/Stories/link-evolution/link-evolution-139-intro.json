    {
      "char": "kitetenjo",
      "pos": "NONE",
      "image": "",
      "text": ""
    },
    {
      "char": "yumatsukumo",
      "pos": "NONE",
      "image": "",
      "text": ""
    },
    {
      "char": "infn8",
      "pos": "CENTER",
      "image": "",
      "text": "Yuma et Kite finirent par retrouver Quinton et Hart. Quinton était avec ses deux frères, Quattro et Trey."
