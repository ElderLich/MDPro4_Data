      "image": "",
      "text": ""
    },
    {
      "char": "infn8",
      "pos": "",
      "image": "",
      "text": "Yuma se mit à la recherche de Hart et le suivit jusqu'au sommet d'une tour mystérieuse."
    },
    {
      "char": "infn8",
      "pos": "",
      "image": "",
