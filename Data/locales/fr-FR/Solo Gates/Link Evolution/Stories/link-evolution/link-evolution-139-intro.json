    {
      "char": "kitetenjo",
      "pos": "LEFT",
      "image": "",
      "text": ""
    },
    {
      "char": "quattro",
      "pos": "RIGHT",
      "image": "",
      "text": "Ce n'est nul autre que l'infâme Kite. Quel honneur."
    },
    {
      "char": "yumatsukumo",
      "pos": "",
