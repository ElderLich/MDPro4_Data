    {
      "char": "harttenjo",
      "pos": "",
      "image": "",
      "text": "..."
    },
    {
      "char": "quinton",
      "pos": "",
      "image": "",
      "text": "Hart sera parfaitement en sécurité avec moi, je t'assure. Allons-y."
    },
    {
      "char": "harttenjo",
      "pos": "NONE",
      "image": "",
      "text": ""
    },
    {
      "char": "quinton",
      "pos": "NONE",
      "image": "",
      "text": ""
    },
    {
      "char": "yumatsukumo",
      "pos": "NONE",
      "image": "",
      "text": ""
    },
    {
      "char": "infn8",
      "pos": "CENTER",
      "image": "",
      "text": "Après que Hart fut enlevé par Quinton, Yuma dut faire équipe avec Kite pour le retrouver."
    },
    {
      "char": "infn8",
      "pos": "NONE",
      "image": "",
      "text": ""
    },
    {
      "char": "yumatsukumo",
      "pos": "LEFT",
      "image": "",
      "text": ""
    },
    {
      "char": "kitetenjo",
      "pos": "RIGHT",
      "image": "anger",
      "text": "Dis-moi où se trouve Hart!"
    },
    {
      "char": "yumatsukumo",
      "pos": "",
      "image": "",
      "text": "Le gars que tu as envoyé est venu dans un hélicoptère pour venir chercher ton frère."
    },
    {
      "char": "kitetenjo",
      "pos": "",
      "image": "",
      "text": "Je n'ai envoyé personne pour venir le chercher."
    },
    {
      "char": "yumatsukumo",
      "pos": "",
      "image": "surprise",
      "text": "Alors il n'était pas ton ami?"
    },
    {
      "char": "orbital7",
      "pos": "CENTER",
      "image": "",
      "text": "Arrête d'essayer de nous tromper!"
    },
    {
      "char": "orbital7",
      "pos": "",
      "image": "",
      "text": "Nous n'avons pas été créés hier, tu sais."
