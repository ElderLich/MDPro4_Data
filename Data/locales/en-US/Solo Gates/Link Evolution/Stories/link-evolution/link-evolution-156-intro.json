{
  "name": "TheBattleOfThreeWorlds_INTRO",
  "script": [
    {
      "char": "command",
      "pos": "BG",
      "image": "zexal_barian",
      "text": ""
    },
    {
      "char": "yumatsukumo",
      "pos": "LEFT",
      "image": "surprise",
      "text": "Shark!"
    },
    {
      "char": "nash",
      "pos": "RIGHT",
      "image": "neutral",
      "text": "Don Thousand’s power still remains."
    },
    {
      "char": "nash",
      "pos": "",
      "image": "",
      "text": "It’s also pulling our worlds into a collision course with Astral World."
    },
    {
      "char": "nash",
      "pos": "",
      "image": "",
      "text": "If our three worlds collide, Astral World will be destroyed."
    },
    {
      "char": "yumatsukumo",
      "pos": "",
      "image": "anger",
      "text": "But since we defeated Don Thousand, his power should be gone."
    },
    {
      "char": "nash",
      "pos": "",
      "image": "win",
      "text": "It’s not. Because I inherited Don Thousand’s energies!"
    },
    {
      "char": "yumatsukumo",
      "pos": "",
      "image": "surprise",
      "text": "What? You absorbed Don Thousand’s power?"
    },
    {
      "char": "nash",
      "pos": "",
      "image": "neutral",
      "text": "You forget that I’m a Barian."
    },
    {
      "char": "nash",
      "pos": "",
      "image": "",
      "text": "Barian World and Astral World are sworn enemies locked in a war with each other."
    },
    {
      "char": "nash",
      "pos": "",
      "image": "",
      "text": "So if you want to save Astral World, you’ll have to defeat me!"
    },
    {
      "char": "yumatsukumo",
      "pos": "",
      "image": "anger",
      "text": "But Shark, I don’t want to fight a friend!"
    },
    {
      "char": "nash",
      "pos": "",
      "image": "lose",
      "text": "Wrong!"
    },
    {
      "char": "nash",
      "pos": "",
      "image": "neutral",
      "text": "We are NOT friends. Not as long as you take Astral’s side."
    },
    {
      "char": "yumatsukumo",
      "pos": "",
      "image": "surprise",
      "text": "There’s got to be some way that we can work it out! Please?"
    },
    {
      "char": "nash",
      "pos": "",
      "image": "",
      "text": "There isn’t."
    },
    {
      "char": "astral",
      "pos": "CENTER",
      "image": "",
      "text": "For once, Shark and I agree."
    },
    {
      "char": "astral",
      "pos": "",
      "image": "",
      "text": "Our worlds cannot mutually exist. We must do battle."
    },
    {
      "char": "nash",
      "pos": "",
      "image": "",
      "text": "Now let’s find out which one of our worlds will survive!"
    }
  ]
}
