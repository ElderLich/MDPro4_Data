      "image": "neutral",
      "text": ""
    },
    {
      "char": "yugo",
      "pos": "",
      "image": "anger",
      "text": "It's you again! Give Rin back and I might go easy on you."
    },
    {
      "char": "yuto",
      "pos": "",
      "image": "anger",
      "text": "You threatening me? Bring it on!"
    },
