      "text": ""
    },
    {
      "char": "yugo",
      "pos": "",
      "image": "surprise",
      "text": "Woah… What's goin' on? Clear Wing Synchro Dragon? Why are you glowing?"
    },
    {
      "char": "command",
      "pos": "BG",
      "image": "arcv_heartlandcity",
      "text": ""
