    {
      "char": "yumatsukumo",
      "pos": "LEFT",
      "image": "surprise",
      "text": "\"We have your friend. Follow us to get her back.\""
    },
    {
      "char": "infn8",
      "pos": "CENTER",
      "image": "",
      "text": "After cat-napping Tori, the frisky felines led Yuma to Cathy Katherine."
    },
    {
      "char": "command",
      "pos": "BG",
      "image": "zexal_city_night",
      "text": ""
    },
    {
      "char": "cathykatherine",
      "pos": "RIGHT",
      "image": "",
      "text": "Thank you for coming, Yuma."
    },
    {
      "char": "yumatsukumo",
      "pos": "LEFT",
      "image": "anger",
      "text": "Who are you?"
    },
    {
      "char": "cathykatherine",
      "pos": "",
      "image": "smile",
      "text": "I'm Cathy Katherine. But you can just call me Cat."
    },
    {
      "char": "yumatsukumo",
      "pos": "",
      "image": "anger",
      "text": "What have you done with Tori?"
    },
    {
      "char": "cathykatherine",
      "pos": "",
      "image": "anger",
      "text": "Tori! Tori! Tori! Is she all you think about?"
