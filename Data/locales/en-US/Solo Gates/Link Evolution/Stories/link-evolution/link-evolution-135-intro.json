    {
      "char": "yumatsukumo",
      "pos": "NONE",
      "image": "",
      "text": ""
    },
    {
      "char": "torimeadows",
      "pos": "NONE",
      "image": "",
      "text": ""
    },
    {
      "char": "cathykatherine",
      "pos": "RIGHT",
      "image": "anger",
      "text": "My friends, you're the only ones that care about me. And now I need your help. I need you to deal with an annoying little MOUSE."
    },
    {
      "char": "cathykatherine",
      "pos": "",
      "image": "",
      "text": "This mouse has things I don't have. She has... friends. One friend in particular. It's not fair! She makes me a sad kitten. We don't like her, do we?!"
    },
    {
      "char": "cathykatherine",
      "pos": "RIGHT",
      "image": "smile",
      "text": "I want you to find this little mouse. And when you do, I want you to pounce!"
    },
    {
      "char": "cathykatherine",
      "pos": "NONE",
      "image": "",
      "text": ""
    },
    {
      "char": "command",
      "pos": "BG",
