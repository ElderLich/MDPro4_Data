  "name": "ShadowsOfDoubt_INTRO",
  "script": [
    {
      "char": "command",
      "pos": "BG",
      "image": "5ds_satellite",
      "text": ""
    },
    {
      "char": "carlycarmine",
      "pos": "RIGHT",
      "image": "dark_smile",
      "text": "I’ve been waiting for you, Jackie!"
    },
    {
      "char": "jackatlas",
      "pos": "LEFT",
      "image": "discouragement",
      "text": "No...You can’t be a Dark Signer..."
    },
    {
      "char": "carlycarmine",
      "pos": "",
      "image": "dark_smile",
      "text": "But I am."
    },
    {
      "char": "jackatlas",
      "pos": "",
      "image": "discouragement",
      "text": "Carly, who did this to you?"
    },
    {
      "char": "carlycarmine",
      "pos": "",
      "image": "dark_bittersleep",
      "text": "Who, Jack? You must be joking – the answer is so obvious."
    },
    {
      "char": "carlycarmine",
      "pos": "",
      "image": "dark_anger",
      "text": "You are the one responsible!"
    },
    {
      "char": "jackatlas",
      "pos": "",
      "image": "surprise",
      "text": "No, you’re mistaken. I’m the one who’s trying to save you!"
    },
    {
      "char": "carlycarmine",
      "pos": "",
      "image": "dark_smile",
      "text": "Please. You chose to cut me off because you thought I was one of the paparazzi."
    },
    {
      "char": "jackatlas",
      "pos": "",
      "image": "surprise",
      "text": "That's not true!"
    },
    {
      "char": "jackatlas",
      "pos": "",
      "image": "anger",
      "text": "I kept you at a distance because I didn't want you to get hurt!"
    },
    {
      "char": "carlycarmine",
      "pos": "",
      "image": "dark_anger",
      "text": "Well, you failed. And now it's my turn to even the score!"
    },
    {
      "char": "carlycarmine",
      "pos": "",
      "image": "dark_anger",
      "text": "Ah, the irony. Before, I was chasing after you and hanging off your every word. But now, things have gone full circle."
    },
    {
      "char": "carlycarmine",
      "pos": "",
      "image": "dark_smile",
      "text": "You're now the desperate one."
    },
    {
      "char": "jackatlas",
      "pos": "",
      "image": "anger",
      "text": "That’s right. Desperate to get the old Carly back. And there’s no way I’ll be denied!"
    }
  ]
}
