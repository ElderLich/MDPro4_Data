      "text": "Astral!"
    },
    {
      "char": "number96",
      "pos": "",
      "image": "",
      "text": "Yuma, your friend can't help you anymore. In fact, he can't even help himself!"
    },
    {
      "char": "number96",
      "pos": "",
      "image": "",
      "text": "I will destroy everything!"
    },
    {
      "char": "astral",
