      "char": "infn8",
      "pos": "NONE",
      "image": "",
      "text": ""
    },
    {
      "char": "tetsutrudge",
      "pos": "",
      "image": "smile",
      "text": "I knew I shoulda locked you up when you were a kid. Looks like I’ll finally get my wish!"
