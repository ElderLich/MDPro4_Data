      "image": "",
      "text": ""
    },
    {
      "char": "rallydawson",
      "pos": "RIGHT",
      "image": "",
      "text": ""
    },
    {
      "char": "infn8",
      "pos": "",
      "image": "",
      "text": "Yusei's friend Rally \"found\" a Skylon-30 acceleration chip. Yusei needed this chip badly for the new Duel Runner he was building."
    },
    {
      "char": "infn8",
      "pos": "NONE",
      "image": "",
      "text": ""
    },
    {
      "char": "rallydawson",
      "pos": "RIGHT",
      "image": "surprise",
      "text": "Yusei! Hey, Yusei!"
    },
    {
      "char": "yuseifudo",
      "pos": "",
      "image": "notattoo_neutral",
      "text": ""
    },
    {
      "char": "rallydawson",
      "pos": "",
      "image": "neutral",
      "text": "Check this out!"
