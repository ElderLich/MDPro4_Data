    {
      "char": "rallydawson",
      "pos": "",
      "image": "",
      "text": "It's a Skylon-30 Acceleration Chip."
    },
    {
      "char": "yuseifudo",
      "pos": "",
      "image": "notattoo_neutral",
      "text": "Aren’t those incredibly expensive? Don’t tell me you stole this."
    },
    {
      "char": "rallydawson",
      "pos": "",
      "image": "anger",
      "text": "I didn’t steal nothin’! It was just laying on the ground in broad daylight."
