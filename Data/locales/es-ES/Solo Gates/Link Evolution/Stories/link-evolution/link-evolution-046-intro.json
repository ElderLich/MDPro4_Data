    {
      "char": "crowhoganarcv",
      "pos": "RIGHT",
      "image": "anger",
      "text": "¡Déjenlos tranquilos! Raikiri, ¡abre un camino!"
    },
    {
      "char": "command",
      "pos": "PROP_OFF",
      "image": "arcv_raikirirosecard",
      "text": ""
    },
    {
      "char": "shingo",
      "pos": "LEFT",
      "image": "neutral",
      "text": "¡Gracias por sacarnos las castañas del fuego! Podría haber tomado el control de la situación, ¡pero saltar de una dimensión a otra es de lo más agotador!"
    },
    {
      "char": "crowhoganarcv",
      "pos": "CENTER",
      "image": "surprise",
      "text": "Eh... ¿De dónde dices que vienes?"
    },
    {
      "char": "crowhoganarcv",
      "pos": "",
      "image": "neutral",
      "text": ""
    },
    {
      "char": "shingo",
      "pos": "",
      "image": "neutral",
      "text": "De Ciudad Paraíso. Me llamo Sylvio Sawatari. En la Dimensión Estándar, soy toda una superestrella de los Duelos."
    },
    {
      "char": "yuya",
      "pos": "RIGHT",
      "image": "neutral",
      "text": ""
    },
    {
      "char": "shingo",
      "pos": "",
      "image": "smile",
      "text": "Y este es Yuya Sakaki, mi ayudante."
    },
    {
      "char": "yuya",
      "pos": "",
      "image": "anger",
      "text": "¡¿Qué?!"
    },
    {
      "char": "celina",
      "pos": "RIGHT",
      "image": "neutral",
      "text": ""
    },
    {
      "char": "shingo",
      "pos": "",
      "image": "neutral",
      "text": "Y esta joven de aquí es Celina. Viene de una dimensión totalmente distinta."
    },
    {
      "char": "celina",
      "pos": "",
      "image": "anger",
      "text": "!"
    },
    {
      "char": "celina",
      "pos": "NONE",
      "image": "",
      "text": ""
    },
    {
      "char": "yuya",
      "pos": "RIGHT",
      "image": "neutral",
      "text": "Sé que es difícil de creer, pero hemos venido a tu dimensión en busca de duelistas que nos ayuden a salvar la galaxia."
    },
    {
      "char": "crowhoganarcv",
      "pos": "",
      "image": "smile",
      "text": "No acabo de entender qué les funciona mal en la cabeza, pero parecen buena gente."
    },
    {
      "char": "duelchaser227",
      "pos": "LEFT",
      "image": "anger",
      "text": ""
    },
    {
      "char": "rileyakaba",
      "pos": "LEFT",
      "image": "surprise",
      "text": "¡Ah!"
    },
    {
      "char": "crowhoganarcv",
      "pos": "",
      "image": "surprise",
      "text": "¡El Sector de Seguridad!"
    },
    {
      "char": "shingo",
      "pos": "",
      "image": "anger",
      "text": "¡Suéltame! ¿Acaso no sabes quién soy?"
    },
    {
      "char": "duelchaser227",
      "pos": "",
      "image": "smile",
      "text": "Sí que lo sé: ¡eres mi arresto más reciente!"
