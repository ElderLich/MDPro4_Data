    },
    {
      "char": "duelchaser227",
      "pos": "LEFT",
      "image": "neutral",
      "text": "¡Llevamos desde anoche buscándolos, sucios criminales!"
    },
    {
      "char": "yuya",
      "pos": "RIGHT",
      "image": "surprise",
      "text": "¿Desde anoche? Pero si acabamos de llegar."
    },
    {
      "char": "duelchaser227",
