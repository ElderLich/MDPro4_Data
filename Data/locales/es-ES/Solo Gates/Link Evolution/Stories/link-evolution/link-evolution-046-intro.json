    {
      "char": "infn8",
      "pos": "",
      "image": "",
      "text": "Cuervo y Gong se enfrentaron en el primer Duelo de la Copa de la Amistad."
    },
    {
      "char": "gogenzaka",
      "pos": "RIGHT",
      "image": "surprise",
      "text": "Gong nunca ha montado en triciclo, pero si va a ganar este torneo, ¡tendrá que dejar las dudas a un lado y entregarse por completo!"
    },
    {
      "char": "crowhoganarcv",
      "pos": "LEFT",
      "image": "anger",
      "text": "¡Tengo que ganar este torneo! Y no me detendré, aunque tenga que pisotear a Gong para hacerlo."
