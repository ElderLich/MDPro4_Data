      "text": "Desde luego, esto no ha sido un viaje en primera clase."
    },
    {
      "char": "yuya",
      "pos": "RIGHT",
      "image": "surprise",
      "text": "¿Dónde estamos?"
    },
    {
      "char": "celina",
      "pos": "RIGHT",
      "image": "neutral",
      "text": "Como dijo Declan, en la Dimensión de Sincronía."
