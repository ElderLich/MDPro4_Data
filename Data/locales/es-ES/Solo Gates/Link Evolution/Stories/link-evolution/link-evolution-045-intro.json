      "char": "infn8",
      "pos": "",
      "image": "",
      "text": "No tardaron en verse interrumpidos por un oficial del Sector de Seguridad."
    },
    {
      "char": "duelchaser227",
      "pos": "",
      "image": "neutral",
      "text": "¡Dos Comunes! ¡Alto! ¡Esta zona es exclusiva de la Élite!"
