    {
      "char": "rio",
      "pos": "RIGHT",
      "image": "anger",
      "text": "Reginald, ho pensato che avremmo camminato a scuola insieme!"
    },
    {
      "char": "rio",
      "pos": "",
      "image": "anger",
      "text": "Che c'è, sei troppo cool per essere visto con la tua sorellina?"
    },
    {
      "char": "reginaldkastle",
      "pos": "",
      "image": "neutral",
      "text": ""
    },
    {
      "char": "yumatsukumo",
      "pos": "",
      "image": "smile",
      "text": "Sono felice di vederti di nuovo in piedi, Rio!"
    },
    {
      "char": "rio",
      "pos": "",
      "image": "smile",
      "text": "È così bello incontrare delle facce amichevoli! Un grande inizio per il mio primo giorno scolastico."
    },
    {
      "char": "reginaldkastle",
      "pos": "NONE",
      "image": "",
      "text": ""
    },
    {
      "char": "yumatsukumo",
