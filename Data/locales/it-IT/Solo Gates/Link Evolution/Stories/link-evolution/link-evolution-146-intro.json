    {
      "char": "infn8",
      "pos": "CENTER",
      "image": "",
      "text": "Intanto sulla Terra, Yuma incontra un nuovo studente."
    },
    {
      "char": "infn8",
      "pos": "NONE",
      "image": "",
      "text": ""
    },
    {
      "char": "rayshadows",
      "pos": "RIGHT",
      "image": "neutral",
      "text": "Wow! Io ti conosco! Sei Yuma, il campione del Carnevale Mondiale di Duelli."
    },
    {
      "char": "yumatsukumo",
      "pos": "",
      "image": "",
      "text": ""
    },
    {
      "char": "rayshadows",
      "pos": "",
