    {
      "char": "infn8",
      "pos": "CENTER",
      "image": "",
      "text": "La scuola diventò pericolosa quando Girag attaccò Yuma."
    },
    {
      "char": "infn8",
      "pos": "NONE",
      "image": "",
      "text": ""
    },
    {
      "char": "girag",
      "pos": "RIGHT",
      "image": "anger",
      "text": ""
    },
    {
      "char": "girag",
      "pos": "",
      "image": "anger",
      "text": "Sono Girag, un guerriero Bariano. Tu sarai sconfitto, idiota!"
    },
    {
      "char": "girag",
      "pos": "",
      "image": "",
      "text": ""
    },
    {
      "char": "yumatsukumo",
      "pos": "",
      "image": "",
      "text": ""
    },
    {
      "char": "alito",
      "pos": "CENTER",
      "image": "",
      "text": ""
    },
    {
      "char": "infn8",
      "pos": "",
      "image": "",
      "text": "Improvvisamente, Alit apparve e salvò Yuma."
    },
    {
      "char": "infn8",
      "pos": "NONE",
      "image": "",
      "text": ""
    },
    {
      "char": "girag",
      "pos": "RIGHT",
      "image": "surprise",
      "text": "Perché lo stai aiutando!?"
    },
    {
      "char": "alito",
      "pos": "CENTER",
      "image": "anger",
      "text": "Sono affari miei!"
    },
    {
      "char": "girag",
      "pos": "",
      "image": "",
      "text": "Sei un traditore!"
    },
    {
      "char": "girag",
      "pos": "",
      "image": "",
      "text": "Abbiamo bisogno dei Numeri di quel ragazzino per salvare il nostro mondo!"
    },
    {
      "char": "alito",
      "pos": "",
      "image": "anger",
      "text": "Sì, sono consapevole di questo."
    },
    {
      "char": "alito",
      "pos": "",
      "image": "",
      "text": "Ma voglio battere Yuma e Astral da solo! Non tu: io!"
    },
    {
      "char": "girag",
      "pos": "",
      "image": "anger",
      "text": "GRRRRR!"
    },
    {
      "char": "girag",
      "pos": "NONE",
      "image": "",
      "text": ""
    },
    {
      "char": "alito",
      "pos": "RIGHT",
      "image": "",
      "text": ""
    },
    {
      "char": "yumatsukumo",
      "pos": "",
      "image": "anger",
      "text": "Un momento. Se accetto, devo mettere i miei Numeri in palio giusto?"
    },
    {
      "char": "alito",
      "pos": "",
      "image": "",
      "text": "Naturalmente. Entrambi duelleremo per i Numeri e la nostra stessa sopravvivenza."
    },
    {
      "char": "alito",
      "pos": "",
      "image": "",
      "text": "Sono disposto a rischiare tutto per duellare contro di voi. Batterò te e Astral!"
