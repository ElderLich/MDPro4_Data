    {
      "char": "infn8",
      "pos": "CENTER",
      "image": "",
      "text": "Il Grand Prix sta per iniziare e tutte le squadre sono pronte!"
    },
    {
      "char": "infn8",
      "pos": "",
      "image": "",
      "text": "Il primo abbinamento fu il Team 5D's contro il Team Unicorn!"
    },
