      "pos": "RIGHT",
      "image": "",
      "text": ""
    },
    {
      "char": "kitetenjo",
      "pos": "",
      "image": "",
      "text": "Come ti senti?"
    },
    {
      "char": "kitetenjo",
      "pos": "",
      "image": "",
      "text": "Ho raccolto altri Numeri per aiutarti."
    },
    {
      "char": "kitetenjo",
      "pos": "",
      "image": "",
      "text": "Prima che te ne accorga, ti sentirai molto meglio."
    },
    {
      "char": "kitetenjo",
      "pos": "",
      "image": "",
      "text": "Devi solamente resistere."
    },
    {
      "char": "kitetenjo",
      "pos": "",
      "image": "discouragement",
      "text": "Pensi di potercela fare per me?"
    },
    {
      "char": "kitetenjo",
