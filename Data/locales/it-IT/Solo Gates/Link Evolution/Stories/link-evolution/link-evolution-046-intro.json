    {
      "char": "duelchaser227",
      "pos": "LEFT",
      "image": "neutral",
      "text": "È da ieri sera che vi cerchiamo dappertutto, mocciosi!"
    },
    {
      "char": "yuya",
      "pos": "RIGHT",
      "image": "surprise",
      "text": "Ieri sera? Ma se siamo appena arrivati!"
    },
    {
      "char": "duelchaser227",
