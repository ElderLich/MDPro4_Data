    {
      "char": "crowhoganarcv",
      "pos": "RIGHT",
      "image": "anger",
      "text": "Lasciate stare quella gente! Raikiri, apri un varco!"
    },
    {
      "char": "command",
      "pos": "PROP_OFF",
      "image": "arcv_raikirirosecard",
      "text": ""
    },
    {
      "char": "shingo",
      "pos": "LEFT",
      "image": "neutral",
      "text": "Grazie per averci salvato la pelle! Avrei preso il controllo della situazione io stesso, ma saltare da una dimensione all'altra è sfiancante."
    },
    {
      "char": "crowhoganarcv",
      "pos": "CENTER",
      "image": "surprise",
      "text": "Ehm, da dov'è che siete saltati?"
    },
    {
      "char": "crowhoganarcv",
      "pos": "",
      "image": "neutral",
      "text": ""
    },
    {
      "char": "shingo",
      "pos": "",
      "image": "neutral",
      "text": "Da Paradise City. Sono Shingo Sawatari. Nella Dimensione Standard sono una superstar dei duelli."
    },
    {
      "char": "yuya",
      "pos": "RIGHT",
      "image": "neutral",
      "text": ""
    },
    {
      "char": "shingo",
      "pos": "",
      "image": "smile",
      "text": "Questo invece è Yuya Sakaki, il mio assistente personale."
    },
    {
      "char": "yuya",
      "pos": "",
      "image": "anger",
      "text": "Cosa?!"
    },
    {
      "char": "celina",
      "pos": "RIGHT",
      "image": "neutral",
      "text": ""
    },
    {
      "char": "shingo",
      "pos": "",
      "image": "neutral",
      "text": "E questa peperina qui è Celina. Viene da un'altra dimensione ancora."
    },
    {
      "char": "celina",
      "pos": "",
      "image": "anger",
      "text": "!"
    },
    {
      "char": "celina",
      "pos": "NONE",
      "image": "",
      "text": ""
    },
    {
      "char": "yuya",
      "pos": "RIGHT",
      "image": "neutral",
      "text": "So che è difficile da credere, ma abbiamo viaggiato fino alla vostra dimensione per trovare duellanti che possano aiutarci a salvare la galassia."
    },
    {
      "char": "crowhoganarcv",
      "pos": "",
      "image": "smile",
      "text": "Sentite, non so che razza di svitati siete, ma non sembrate cattivi."
    },
    {
      "char": "duelchaser227",
      "pos": "LEFT",
      "image": "anger",
      "text": ""
    },
    {
      "char": "rileyakaba",
      "pos": "LEFT",
      "image": "surprise",
      "text": "Ah!"
    },
    {
      "char": "crowhoganarcv",
      "pos": "",
      "image": "surprise",
      "text": "La Sicurezza!"
    },
    {
      "char": "shingo",
      "pos": "",
      "image": "anger",
      "text": "Lasciatemi andare! Non sapete chi sono?"
    },
    {
      "char": "duelchaser227",
      "pos": "",
      "image": "smile",
      "text": "Sì, lo so: il mio ultimo arresto!"
    },
    {
      "char": "yuya",
      "pos": "NONE",
      "image": "",
