      "text": ""
    },
    {
      "char": "jeanmichelroget",
      "pos": "NONE",
      "image": "",
      "text": ""
    },
    {
      "char": "infn8",
      "pos": "",
      "image": "",
      "text": "E così ebbe inizio il Torneo dell'Amicizia. I duellanti si sfidarono in Duelli Turbo a bordo delle Duel Runner."
    },
    {
      "char": "command",
      "pos": "BG",
      "image": "arcv_friendshipcup",
      "text": ""
    },
    {
      "char": "infn8",
      "pos": "",
      "image": "",
      "text": "Crow e Gong si affrontarono nell'incontro di apertura del Torneo dell'Amicizia."
    },
    {
      "char": "gogenzaka",
      "pos": "RIGHT",
      "image": "surprise",
      "text": "Gong non è mai salito neanche su un triciclo prima d'ora... Ma per vincere questo torneo, Gong deve smettere di aver paura di cadere e spingere l'acceleratore!"
    },
    {
      "char": "crowhoganarcv",
      "pos": "LEFT",
      "image": "anger",
      "text": "Devo vincere questo torneo! Se questo significa che devo schiacciare Gong, allora è proprio quello che farò."
    }
