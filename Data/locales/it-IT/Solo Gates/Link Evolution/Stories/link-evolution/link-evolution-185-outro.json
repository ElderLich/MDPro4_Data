    },
    {
      "char": "luna",
      "pos": "LEFT",
      "image": "neutral",
      "text": "Questa città custodisce moltissimi ricordi."
    },
    {
      "char": "leo",
      "pos": "RIGHT",
      "image": "neutral",
      "text": "Già. Non dimenticherò mai questo posto."
    },
    {
      "char": "luna",
      "pos": "",
      "image": "goodnightssleep",
      "text": "Leo, sei cambiato."
    },
    {
      "char": "leo",
      "pos": "",
      "image": "surprise",
      "text": "Davvero?"
    },
    {
      "char": "luna",
      "pos": "",
      "image": "smile",
      "text": "Eri un piagnucolone, ma ora posso contare su di te nei momenti difficili."
    },
    {
      "char": "leo",
      "pos": "",
      "image": "shy",
      "text": "Veramente?"
    },
    {
      "char": "luna",
      "pos": "",
      "image": "neutral",
      "text": "Sì, sei davvero cresciuto."
    },
    {
      "char": "leo",
      "pos": "",
      "image": "smile",
      "text": "Beh, ho dovuto farlo! Altrimenti, chi altro proteggerebbe la mia sorellina?"
    },
    {
      "char": "luna",
      "pos": "",
      "image": "smile",
      "text": "Sorellina a chi?"
    },
    {
      "char": "leo",
      "pos": "NONE",
      "image": "",
      "text": ""
    },
    {
      "char": "luna",
      "pos": "NONE",
      "image": "",
      "text": ""
    },
    {
      "char": "command",
      "pos": "BG",
      "image": "5ds_arena",
      "text": ""
    },
    {
      "char": "jackatlas",
      "pos": "LEFT",
      "image": "anger",
      "text": "Carly!"
    },
    {
      "char": "carlycarmine",
      "pos": "RIGHT",
      "image": "glasses_shy",
      "text": "C-come facevi a sapere che ero qui? Comunque, posso unirmi a te nel tuo viaggio? Ti dispiace?"
    },
    {
      "char": "jackatlas",
      "pos": "",
      "image": "discouragement",
      "text": "Certo che mi dispiace! Voglio diventare il Duellante più forte del mondo! Non mi posso permettere distrazioni!"
    },
    {
      "char": "carlycarmine",
      "pos": "",
      "image": "glasses_discouragement",
      "text": "Jack..."
    },
    {
      "char": "jackatlas",
      "pos": "",
      "image": "anger",
      "text": "La prossima volta che ci vedremo, sarò il re del mondo! Addio!"
    },
    {
      "char": "jackatlas",
      "pos": "NONE",
      "image": "",
      "text": ""
    },
    {
      "char": "carlycarmine",
      "pos": "",
      "image": "glasses_surprise",
      "text": "\"La prossima volta che ci vedremo...\" Quindi mi vuole vedere!"
    },
    {
      "char": "carlycarmine",
      "pos": "NONE",
      "image": "",
      "text": ""
    },
    {
      "char": "command",
      "pos": "BG",
      "image": "5ds_yuseihome",
      "text": ""
    },
    {
      "char": "yuseifudo",
      "pos": "LEFT",
      "image": "surprise",
      "text": "Akiza?"
    },
    {
      "char": "akizaizinski",
      "pos": "RIGHT",
      "image": "discouragement",
      "text": "Yusei, allora sarai l'unico a rimanere qui."
    },
    {
      "char": "yuseifudo",
      "pos": "",
      "image": "neutral",
      "text": "Già. Il tuo volo è domani, giusto?"
    },
    {
      "char": "akizaizinski",
      "pos": "",
      "image": "normal2",
      "text": "Sì, ma volevo essere sicura di riuscire a salutarti, Yusei."
    },
    {
      "char": "yuseifudo",
      "pos": "",
      "image": "neutral",
      "text": "Certo."
    },
    {
      "char": "akizaizinski",
      "pos": "",
      "image": "shy",
      "text": "Yusei... volevo solo dirti che io... io..."
    },
    {
      "char": "akizaizinski",
      "pos": "",
      "image": "shy2",
      "text": "Sono felice di averti conosciuto."
    },
    {
      "char": "yuseifudo",
      "pos": "",
      "image": "shy",
      "text": "Anch'io, Akiza."
    },
    {
      "char": "akizaizinski",
      "pos": "",
      "image": "goodnightssleep",
      "text": "La prima volta che ci siamo incontrati, mi hai fatto un po' paura."
    },
    {
      "char": "yuseifudo",
      "pos": "",
      "image": "smile",
      "text": "Paura? IO? Tu eri conosciuta come la Strega della Rosa Nera! Dovresti vederti quando lanci certe occhiatacce. Non sapevo cosa mi avresti fatto se avessi perso."
    },
    {
      "char": "akizaizinski",
      "pos": "",
      "image": "anger",
      "text": "Cosa? L'hai pensato davvero?"
    },
    {
      "char": "yuseifudo",
      "pos": "",
      "image": "goodnightssleep",
      "text": "Ma allo stesso tempo, il tuo sorriso è il più bello del mondo."
    },
    {
      "char": "akizaizinski",
      "pos": "",
      "image": "smile",
      "text": "E tu sei quello che mi fa sorridere, Yusei."
    },
    {
      "char": "yuseifudo",
      "pos": "",
      "image": "smile",
      "text": ""
    },
    {
      "char": "akizaizinski",
      "pos": "",
      "image": "shy2",
      "text": "Beh... Ciao..."
    },
    {
      "char": "yuseifudo",
      "pos": "",
      "image": "smile",
      "text": "In bocca al lupo."
    },
    {
      "char": "akizaizinski",
      "pos": "NONE",
      "image": "",
      "text": ""
    },
    {
      "char": "command",
      "pos": "BG",
      "image": "5ds_citysquare",
      "text": ""
    },
    {
      "char": "infn8",
      "pos": "CENTER",
      "image": "",
      "text": "L'ultima notte prima della partenza dei suoi amici verso destinazioni diverse, Yusei osservò Nuova Domino, la città che avevano contribuito a proteggere."
    },
    {
      "char": "tetsutrudge",
      "pos": "RIGHT",
      "image": "smile",
      "text": "Ehi! Che ci fa qui questo tipo sospetto?"
    },
    {
      "char": "yuseifudo",
      "pos": "",
      "image": "surprise",
      "text": "Trudge!"
    },
    {
      "char": "tetsutrudge",
      "pos": "",
      "image": "neutral",
      "text": "Ho sentito dire che domani partono tutti. Tu stai bene?"
    },
    {
      "char": "yuseifudo",
      "pos": "",
      "image": "discouragement",
      "text": "Mi dispiace che se ne vadano... Ma mi dispiacerebbe di più se non seguissero i loro sogni."
    },
    {
      "char": "tetsutrudge",
      "pos": "",
      "image": "discouragement",
      "text": "Pensi che resterete amici?"
    },
    {
      "char": "yuseifudo",
      "pos": "",
      "image": "neutral",
      "text": "Ma certo, abbiamo un legame. Un legame indissolubile che diventerà sempre più forte."
    },
    {
      "char": "yuseifudo",
      "pos": "",
      "image": "neutral",
      "text": "Siamo tutti diretti verso la prossima tappa della nostra vita, e non vedo l'ora di scoprire dove ci porterà."
    },
    {
      "char": "tetsutrudge",
      "pos": "",
      "image": "smile",
      "text": "Ehi! Da quando sei diventato così saggio?"
    },
    {
      "char": "yuseifudo",
      "pos": "",
      "image": "neutral",
      "text": "Nel mio Duello contro Jack, mi sono reso conto che la mia anima è legata a questa città."
    },
    {
      "char": "yuseifudo",
      "pos": "",
      "image": "smile",
      "text": "Perciò, quando i miei amici un giorno torneranno, dovrò assicurarmi che Nuova Domino sia un luogo che saranno orgogliosi di chiamare casa."
    },
    {
      "char": "tetsutrudge",
      "pos": "NONE",
      "image": "",
      "text": ""
    },
    {
      "char": "yuseifudo",
      "pos": "NONE",
      "image": "",
      "text": ""
    },
    {
      "char": "command",
      "pos": "BG",
      "image": "5ds_duelinghighway",
      "text": ""
    },
    {
      "char": "yuseifudo",
      "pos": "CENTER",
      "image": "neutral",
      "text": "Ok, ragazzi! Questa è l'ultima corsa del Team 5D's, quindi entriamo in azione!"
    },
    {
      "char": "jackatlas",
      "pos": "RIGHT",
      "image": "smile",
      "text": "Quando tornerò, sarò il vero re!"
    },
    {
      "char": "crowhogan",
      "pos": "RIGHT",
      "image": "laughter",
      "text": "A meno che non sia io il re!"
    },
    {
      "char": "leo",
      "pos": "LEFT",
      "image": "smile",
      "text": "Nuova Domino! Non ti dimenticherò mai!"
    },
    {
      "char": "luna",
      "pos": "LEFT",
      "image": "smile",
      "text": "Sarai sempre casa mia!"
    },
    {
      "char": "akizaizinski",
      "pos": "LEFT",
      "image": "smile",
      "text": "Questo non è un addio. È un arrivederci!"
    },
    {
      "char": "yuseifudo",
      "pos": "",
      "image": "neutral",
      "text": "Il futuro ci aspetta su questa strada. Quindi viviamolo al massimo!"
    },
    {
      "char": "yuseifudo",
      "pos": "",
      "image": "smile",
      "text": "Pronti? Partenza... Duelliamo!"
    }
  ]
}
