    },
    {
      "char": "astral",
      "pos": "RIGHT",
      "image": "",
      "text": "Yuma, abbiamo finalmente raggiunto il nostro obiettivo e abbiamo raccolto tutte le Carte Numero. Le loro energie combinate mi consentiranno l'accesso al Codice Numeron, la fonte della creazione in tutto l'universo."
    },
    {
      "char": "astral",
      "pos": "",
      "image": "",
      "text": "Mi dà il potere di riscrivere sia il futuro che il passato."
    },
    {
      "char": "astral",
      "pos": "",
      "image": "",
      "text": "Userò questo potere per compiere la mia missione finale."
    },
    {
      "char": "yumatsukumo",
      "pos": "",
      "image": "surprise",
      "text": "Pensavo che avessimo finito la nostra missione finale."
    },
    {
      "char": "yumatsukumo",
      "pos": "",
      "image": "sad",
      "text": "Aspetta, non vuoi dire che..."
    },
    {
      "char": "astral",
      "pos": "",
      "image": "",
      "text": "La mia missione... annientare il Mondo Bariano."
    },
    {
      "char": "yumatsukumo",
      "pos": "",
      "image": "surprise",
      "text": "Pensavo che avessi finito con queste sciocchezze!"
    },
    {
      "char": "astral",
      "pos": "",
      "image": "",
      "text": "No. Il Mondo Bariano è il nemico del Mondo Astrale. Deve essere terminato."
    },
    {
      "char": "yumatsukumo",
      "pos": "",
      "image": "anger",
      "text": "Non hai imparato niente, Astral?"
    },
    {
      "char": "yumatsukumo",
      "pos": "",
      "image": "anger",
      "text": "Non devi più combattere! I vostri due mondi possono essere in pace!"
    },
    {
      "char": "astral",
      "pos": "",
      "image": "anger",
      "text": "La pace era il tuo obiettivo. Ma non il mio. Il mio rimane la distruzione del Mondo Bariano."
    },
    {
      "char": "yumatsukumo",
      "pos": "",
      "image": "anger",
      "text": "Continua a sognare perché questo non succederà!"
    },
    {
      "char": "astral",
      "pos": "",
      "image": "neutral",
      "text": "E come pensi di fermarmi Yuma? Osi sfidarmi a un duello?"
    },
    {
      "char": "yumatsukumo",
      "pos": "",
      "image": "",
      "text": "Ci puoi scommettere!"
    },
    {
      "char": "astral",
      "pos": "",
      "image": "",
      "text": "È una follia. Io possiedo tutte le Carte Numero, non puoi vincere."
    },
    {
      "char": "astral",
      "pos": "",
      "image": "",
      "text": "Vuoi duellare ancora?"
    },
    {
      "char": "yumatsukumo",
      "pos": "",
      "image": "neutral",
      "text": "Più che mai!"
    },
    {
      "char": "astral",
      "pos": "",
      "image": "",
      "text": "Ottimo. Ma quando vincerò, farò di più che distruggere il Mondo Bariano."
    },
    {
      "char": "astral",
      "pos": "",
      "image": "",
      "text": "Userò il Codice Numeron per cancellare i tuoi ricordi. Sarà come se non ci fossimo mai incontrati."
    },
    {
      "char": "astral",
      "pos": "",
      "image": "",
      "text": "D'accordo?"
    },
    {
      "char": "yumatsukumo",
      "pos": "",
      "image": "",
      "text": "D'accordo."
    },
    {
      "char": "astral",
      "pos": "",
      "image": "",
      "text": "Bene. Duelleremo stasera nel cortile dove ci siamo conosciuti."
    }
  ]
