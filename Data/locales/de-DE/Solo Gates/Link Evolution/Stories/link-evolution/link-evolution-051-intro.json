    {
      "char": "sora",
      "pos": "",
      "image": "smile",
      "text": "Kommt schon, Leute. Ihr könnt euch jetzt entspannen."
    },
    {
      "char": "rileyakaba",
      "pos": "NONE",
      "image": "",
      "text": ""
    },
    {
      "char": "yuya",
      "pos": "LEFT",
      "image": "neutral",
      "text": "Sora! Es ist so schön, dich zu sehen!"
    },
    {
      "char": "celina",
      "pos": "LEFT",
      "image": "anger",
      "text": "„Schön, ihn zu sehen“? Hast du vergessen, dass er Shay verprügelt und versucht hat, mich auch zu erwischen?"
    },
    {
      "char": "sora",
      "pos": "",
      "image": "neutral",
      "text": "Entspann dich. Ich will helfen, nicht dich zur Akademie zurückbringen. Wir sind jetzt auf der gleichen Seite!"
    },
    {
      "char": "yuri",
      "pos": "RIGHT",
      "image": "neutral",
      "text": "Warum sollte irgendjemand freiwillig die Verliererseite wählen?"
    },
    {
      "char": "yuya",
      "pos": "LEFT",
      "image": "surprise",
      "text": "Er sieht genauso aus wie ich!"
    },
    {
      "char": "yuri",
      "pos": "",
      "image": "smile",
      "text": "So viele Verräter auf so kleinem Raum. Der Professor wird nicht glücklich sein."
    },
    {
      "char": "sora",
      "pos": "NONE",
      "image": "",
      "text": ""
    },
    {
      "char": "yuya",
      "pos": "NONE",
      "image": "",
      "text": ""
    },
    {
      "char": "celina",
      "pos": "NONE",
      "image": "",
      "text": ""
    },
    {
      "char": "yugo",
      "pos": "LEFT",
      "image": "anger",
      "text": "Ich habe dich endlich gefunden, du Schlange!"
    },
    {
      "char": "yuri",
      "pos": "",
      "image": "sad",
      "text": "Wie üblich ist dein Timing schrecklich, Pogo. Siehst du nicht, dass ich beschäftigt bin?"
    },
    {
      "char": "yugo",
      "pos": "",
      "image": "anger",
      "text": "Na und?! Das hast du davon, dass du Rin entführt hast!"
    },
    {
      "char": "yuri",
      "pos": "",
      "image": "neutral",
      "text": "Der Professor bekommt, was er will. Er wollte Rin haben. Und jetzt will er, dass ich Celina zu ihm bringe."
    },
    {
      "char": "yugo",
      "pos": "",
      "image": "anger",
      "text": "Jetzt ist Schluss, du Mistkerl."
    },
    {
      "char": "yuri",
      "pos": "",
      "image": "neutral",
      "text": "Du meinst wohl „jetzt ist Schluss für dich“, Dummerchen. Deine Siegchance ist schließlich gleich Null."
    },
    {
      "char": "yugo",
      "pos": "",
      "image": "neutral",
      "text": "Klingt gut! Hä? Das ergibt keinen Sinn … aber ich werde dich einfach schlagen!"
    },
    {
      "char": "yuri",
      "pos": "",
      "image": "sad",
      "text": "Ich kann es einfach nicht glauben, dass ich mich mit diesem Idioten duellieren muss …"
    },
    {
      "char": "yugo",
      "pos": "",
      "image": "anger",
      "text": "Oh doch, glaub das mal! Dieser „Idiot“ ist bereit zum Kampf!"
    },
    {
      "char": "yuri",
      "pos": "",
      "image": "neutral",
      "text": ""
    },
    {
      "char": "yugo",
      "pos": "",
      "image": "anger",
      "text": "Duellieren wir uns!"
    }
  ]
