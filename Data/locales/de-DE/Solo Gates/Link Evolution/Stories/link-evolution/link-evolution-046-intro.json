      "text": ""
    },
    {
      "char": "duelchaser227",
      "pos": "NONE",
      "image": "",
      "text": ""
    },
    {
      "char": "shingo",
      "pos": "NONE",
      "image": "",
      "text": ""
    },
    {
      "char": "command",
      "pos": "BG",
      "image": "arcv_council",
      "text": ""
    },
    {
      "char": "jeanmichelroget",
      "pos": "RIGHT",
      "image": "neutral",
      "text": ""
    },
    {
      "char": "declanakaba",
      "pos": "LEFT",
      "image": "neutral",
      "text": ""
    },
    {
      "char": "infn8",
      "pos": "",
      "image": "",
      "text": "Die Lancer wurden festgenommen und vor den Hohen Rat geführt."
    },
    {
      "char": "jeanmichelroget",
      "pos": "",
      "image": "neutral",
      "text": "Erlaubt mir, mich vorzustellen. Mein Name ist Jean Michel Roget und ich bin der Direktor der Sektorensicherheit."
    },
    {
      "char": "jeanmichelroget",
      "pos": "",
      "image": "anger",
      "text": "Ihr habt euch der Sektorensicherheit widersetzt. Das ist ein schwerwiegender Verstoß gegen die Gesetze der Stadt."
    },
    {
      "char": "yuya",
      "pos": "LEFT",
      "image": "anger",
      "text": "Du kannst uns kaum vorwerfen, dass wir uns verteidigt haben! Deine Leute haben uns gejagt, seit wir aus unserer Dimension hier angekommen sind!"
    },
    {
      "char": "jeanmichelroget",
      "pos": "",
      "image": "smile",
      "text": "„Aus eurer Dimension“?"
    },
    {
      "char": "declanakaba",
      "pos": "LEFT",
      "image": "neutral",
      "text": "Er sagt die Wahrheit. Wir kommen in Frieden, nicht, um Chaos zu stiften. Eure Welt wird sehr bald von Kriegern der Fusionsdimension angegriffen. Wir können euch helfen, sie zu bekämpfen."
    },
    {
      "char": "jeanmichelroget",
      "pos": "",
      "image": "neutral",
      "text": "Einen Moment mal … Dimensionen, die sich bekämpfen? Die Dimensionsreise würde ich euch ja noch abkaufen, aber Dimensionskriege?"
    },
    {
      "char": "jeanmichelroget",
      "pos": "",
      "image": "neutral",
      "text": "So oder so, mein Sicherheitsteam ist ziemlich gut aufgestellt. Wir brauchen eure Hilfe nicht."
    },
    {
      "char": "gale",
      "pos": "CENTER",
      "image": "anger",
      "text": "Genug, Direktor! Wir werden diese Befragung übernehmen. Ihr behauptet, Freunde dieser Welt zu sein? Ihr werdet die Chance erhalten, uns das zu beweisen."
    },
    {
      "char": "shingo",
      "pos": "LEFT",
      "image": "surprise",
      "text": "Beweisen? Wie?"
    },
    {
      "char": "gale",
      "pos": "",
      "image": "neutral",
      "text": "Indem ihr am Freundschafts-Cup teilnehmt."
    },
    {
      "char": "yuya",
      "pos": "LEFT",
      "image": "surprise",
      "text": "Ist das ein Duell-Turnier?"
    },
    {
      "char": "declanakaba",
      "pos": "LEFT",
      "image": "neutral",
      "text": "Wenn diese Leute nicht glauben, dass wir Lancer diese Dimension schützen können, nehmen wir am Turnier teil, um ihnen unser Können zu zeigen."
    },
    {
      "char": "gale",
      "pos": "NONE",
      "image": "",
      "text": ""
    },
    {
      "char": "yuya",
      "pos": "NONE",
      "image": "",
      "text": ""
    },
    {
      "char": "declanakaba",
      "pos": "NONE",
      "image": "",
      "text": ""
    },
    {
      "char": "shingo",
      "pos": "NONE",
      "image": "",
      "text": ""
    },
    {
      "char": "jeanmichelroget",
      "pos": "NONE",
      "image": "",
      "text": ""
    },
    {
      "char": "infn8",
      "pos": "",
      "image": "",
      "text": "Und so begann der Freundschafts-Cup. Duellanten fuhren D-Wheels und maßen sich in Turboduellen."
    },
    {
      "char": "command",
      "pos": "BG",
      "image": "arcv_friendshipcup",
      "text": ""
    },
    {
      "char": "infn8",
      "pos": "",
      "image": "",
      "text": "Crow und Gong standen sich im Eröffnungsmatch des Freundschafts-Cups gegenüber."
    },
    {
      "char": "gogenzaka",
      "pos": "RIGHT",
      "image": "surprise",
      "text": "Gong hat noch nie auf so einem Teil gesessen … Aber wenn Gong dieses Turnier gewinnen will, muss Gong richtig Gas geben!"
    },
    {
      "char": "crowhoganarcv",
      "pos": "LEFT",
      "image": "anger",
      "text": "Ich muss dieses Turnier gewinnen! Wenn das bedeutet, dass ich Gong überfahren muss, dann werde ich genau das tun."
    }
  ]
}
