    {
      "char": "alexisrhodesarcv",
      "pos": "",
      "image": "neutral",
      "text": "Ja. Lass uns loslegen!"
    },
    {
      "char": "yusho",
      "pos": "",
      "image": "neutral",
      "text": "Zeit, Leo zu treffen."
