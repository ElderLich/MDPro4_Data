    {
      "char": "yugo",
      "pos": "",
      "image": "surprise",
      "text": ""
    },
    {
      "char": "rin",
      "pos": "",
      "image": "anger",
      "text": "Jetzt kann ich endlich das hier machen! *Schieb*"
