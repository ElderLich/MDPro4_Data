    {
      "char": "alexisrhodesarcv",
      "pos": "",
      "image": "neutral",
      "text": "In der Duell-Akademie."
    },
    {
      "char": "yugo",
      "pos": "",
      "image": "surprise",
      "text": "Du hast nicht gerade Duell-Akademie gesagt, oder?!"
    },
    {
      "char": "alexisrhodesarcv",
      "pos": "",
      "image": "neutral",
      "text": "Doch. Und wir wissen, wo deine Rin ist."
    },
    {
      "char": "yugo",
      "pos": "",
      "image": "surprise",
      "text": "Was?! Sag mir sofort, wo sie ist!"
    },
    {
      "char": "alexisrhodesarcv",
      "pos": "",
      "image": "neutral",
      "text": "Sie haben sie im Ostturm eingesperrt."
    },
    {
      "char": "yugo",
      "pos": "",
      "image": "surprise",
      "text": "Warum hast du das nicht gleich gesagt?!"
    },
    {
      "char": "yugo",
