    {
      "char": "infn8",
      "pos": "",
      "image": "",
      "text": "Mai schlenderte die Treppen zu Pegasus’ Schloss herauf."
    },
    {
      "char": "maivalentine",
      "pos": "",
      "image": "",
      "text": "Was ist los? Wenn ihr genug Sternenmarken habt, um ins Schloss zu gelangen, was macht ihr dann noch hier?"
    },
    {
      "char": "joeywheeler",
      "pos": "LEFT",
      "image": "sad",
      "text": "Es ist Yugi. Er hat seine Chips an Kaiba verloren und jetzt scheint sein Wille gebrochen zu sein."
    },
    {
      "char": "maivalentine",
      "pos": "",
      "image": "",
      "text": "Aha, der Kleine hat also endlich mal verloren? Dann habt ihr ja Glück, dass ich vorbeigekommen bin."
    },
    {
      "char": "maivalentine",
      "pos": "",
      "image": "",
      "text": "Hör zu, Yugi. Du hast verloren, aber das ist nicht das Ende der Welt."
    },
    {
      "char": "maivalentine",
      "pos": "",
      "image": "surprise",
      "text": "Als ich verloren habe, dachte ich auch, für mich ist alles aus und vorbei. Aber dann bist du aufgetaucht und hast meine Sternenmarken gerettet! Und jetzt revanchiere ich mich!"
    },
    {
      "char": "joeywheeler",
      "pos": "",
      "image": "surprise",
      "text": "Aber wenn du deine Sternenmarken weggibst, kannst du das Preisgeld nicht gewinnen!"
    },
    {
      "char": "maivalentine",
      "pos": "",
      "image": "neutral",
      "text": "Ich bin zwar nett, aber nicht blöd."
    },
    {
      "char": "yamibakura",
      "pos": "LEFT_BACK",
      "image": "ryo_surprise",
      "text": "Wow! Sie hat schon zehn eigene Chips!"
    },
    {
      "char": "yamibakura",
      "pos": "NONE",
      "image": "",
      "text": ""
    },
    {
      "char": "joeywheeler",
      "pos": "NONE",
      "image": "",
      "text": ""
    },
    {
      "char": "maivalentine",
      "pos": "",
      "image": "",
      "text": "Mach weiter, Yugi. Du weißt, ich schulde dir was, also nimm sie."
    },
    {
      "char": "yugimuto",
      "pos": "",
      "image": "sad",
      "text": "…"
    },
    {
      "char": "maivalentine",
      "pos": "",
      "image": "anger",
      "text": "Sind meine Sternenmarken nicht gut genug für dich? Na schön, dann behalte ich sie. Und deine Freunde können dir ja auf dem Weg zurück in den Kindergarten die Nase putzen."
    },
    {
      "char": "maivalentine",
      "pos": "",
      "image": "",
      "text": "Werde erwachsen! Manchmal gewinnt man, manchmal verliert man."
    },
    {
      "char": "teagardner",
      "pos": "LEFT",
      "image": "sad",
      "text": "Mai, sei nicht böse. Du verstehst das einfach nicht."
    },
    {
      "char": "maivalentine",
      "pos": "",
      "image": "smile",
      "text": "Oh, ich verstehe. Dein Freund hat ein lausiges Duell verloren, und jetzt ist er zu feige, um weiterzuspielen, nicht wahr? Wie erbärmlich!"
    },
    {
      "char": "maivalentine",
      "pos": "",
      "image": "",
      "text": "Komm schon, du Feigling. Du kannst dich für sie mit mir duellieren."
    },
    {
      "char": "teagardner",
      "pos": "",
      "image": "anger",
      "text": "Ich werde mich mit dir duellieren! Und zwar hier und jetzt! Für Yugi!"
    }
  ]
