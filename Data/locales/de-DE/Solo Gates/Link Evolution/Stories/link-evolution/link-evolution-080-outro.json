    },
    {
      "char": "yamibakura",
      "pos": "LEFT",
      "image": "",
      "text": ""
    },
    {
      "char": "infn8",
      "pos": "",
      "image": "",
      "text": "Obwohl Yugi dachte, seine Probleme wären vorbei, sollte es daher bald viel schlimmer kommen."
