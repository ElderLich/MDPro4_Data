    "V0046_01_00_12_0": {
      "face": 1,
      "frame": 0,
      "cutin": 0,
      "card": [],
      "duelist": [],
      "text": "這也是為了哥哥……\n我一點也不覺得丟臉──！"
    },
    "V0046_01_00_13_0": {
      "face": 1,
      "frame": 0,
      "cutin": 0,
      "card": [],
      "duelist": [],
      "text": "幹嘛……\n不要一直盯著我看啦！"
    },
    "V0046_01_00_14_0": {
      "face": 1,
      "frame": 0,
      "cutin": 0,
      "card": [],
      "duelist": [],
      "text": "嗚嗚……\n感覺涼颼颼的，好不自在……"
    },
    "V0046_01_00_15_0": {
      "face": 1,
      "frame": 0,
      "cutin": 0,
      "card": [],
      "duelist": [],
      "text": "我、我叫做……瑪莉。\n是……是真的喔？"
    },
    "V0046_01_00_16_0": {
      "face": 1,
      "frame": 0,
      "cutin": 0,
      "card": [],
      "duelist": [
        2,
        301,
        42
      ],
      "text": "哥哥！？\n這、這是……\n因為我很擔心你，所以才……"
    },
    "V0046_28_00_11_0": {
      "face": 2,
      "frame": 0,
      "cutin": 0,
      "card": [],
      "duelist": [],
      "text": "真佩服我自己……\n和瑪莉公主簡直一模一樣。"
    },
    "V0046_28_00_12_0": {
      "face": 8,
      "frame": 0,
      "cutin": 0,
      "card": [],
      "duelist": [],
      "text": "喔呵呵呵呵！\n活～該～！\n……我是說「這就是你的下場」喔。"
    },
    "V0046_28_00_13_0": {
      "face": 2,
      "frame": 0,
      "cutin": 0,
      "card": [],
      "duelist": [],
      "text": "怎麼樣！\n看到這身打扮就鬆懈了吧？\n是我的戰術獲勝了！"
    },
    "V0046_28_00_14_0": {
      "face": 2,
      "frame": 0,
      "cutin": 0,
      "card": [],
      "duelist": [],
      "text": "嘿嘿～！\n怎樣！\n……我是說「輕輕鬆鬆」喔。"
    },
    "V0046_29_00_09_0": {
      "face": 5,
      "frame": 0,
      "cutin": 0,
      "card": [],
      "duelist": [],
      "text": "這樣的話，\n我變裝不就沒有意義了嗎……"
    },
    "V0046_29_00_10_0": {
      "face": 1,
      "frame": 0,
      "cutin": 0,
      "card": [],
      "duelist": [],
      "text": "這也沒辦法……\n既然輸了，就只好乖乖成為祭品……"
    },
    "V0046_29_00_10_1": {
      "face": 3,
      "frame": 0,
      "cutin": 0,
      "card": [],
      "duelist": [],
      "text": "你以為我會這麼說嗎！\n笨～蛋！！"
    },
    "V0046_29_00_11_0": {
      "face": 7,
      "frame": 0,
      "cutin": 0,
      "card": [],
      "duelist": [],
      "text": "可惡！\n要不是穿著這身裝扮，\n我才不會輸咧！"
    },
    "V0046_29_00_12_0": {
      "face": 7,
      "frame": 0,
      "cutin": 0,
      "card": [],
      "duelist": [],
      "text": "對不起，哥哥……\n我沒有幫上你的忙……"
    },
    "V0046_34_00_10_0": {
      "face": 1,
      "frame": 0,
      "cutin": 0,
      "card": [],
      "duelist": [],
      "text": "我、我是瑪莉……喔？"
    },
    "V0046_34_00_11_0": {
      "face": 1,
      "frame": 0,
      "cutin": 0,
      "card": [],
      "duelist": [],
      "text": "嗚……\n不要一直盯著我看啦！"
    },
    "V0046_34_00_12_0": {
      "face": 1,
      "frame": 0,
      "cutin": 0,
      "card": [],
      "duelist": [],
      "text": "嗚、嗚嗚嗚…………"
    },
    "V0046_34_00_13_0": {
      "face": 1,
      "frame": 0,
      "cutin": 0,
      "card": [],
      "duelist": [],
      "text": "傳說中的勇者啊，\n世界能否和平全都靠你們了！\n……我是說「仰賴各位了」喔。"
    },
    "V0046_34_00_14_0": {
      "face": 1,
      "frame": 0,
      "cutin": 0,
      "card": [],
      "duelist": [],
      "text": "拜託你們，還不快點……\n我是說「請去」打倒五頭神龍吧。"
    },
    "V0046_34_00_15_0": {
      "face": 9,
      "frame": 0,
      "cutin": 0,
      "card": [],
      "duelist": [],
      "text": "勇者們，謝謝。\n我絕不會忘了你們！\n……我是說「我會永遠謹記各位的奉獻」。"
    },
    "V0046_35_00_00_0": {
      "face": 1,
      "frame": 0,
      "cutin": 0,
      "card": [],
      "duelist": [],
      "text": "我叫瑪莉，是本國的公主。\n嘿嘿……開玩笑的啦～！"
    },
    "V0046_35_00_01_0": {
      "face": 1,
      "frame": 0,
      "cutin": 0,
      "card": [],
      "duelist": [],
      "text": "嗚嗚……這也是為了哥哥！"
    }
  }
