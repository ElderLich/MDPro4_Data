    "V0907_01_00_05_0": {
      "face": 1,
      "frame": 0,
      "cutin": 0,
      "card": [],
      "duelist": [],
      "text": "いいだろう　受けてやる！\nただしデュエルとなれば\n誰だろうが叩き潰して更地にしてやる！"
    },
