        "caption": {
          "useId": true,
          "tid": "IDS_HELP_STRATEGY_LINK_01_H",
          "ja_JP": "リンク召喚とは？\r",
          "en_US": "",
          "fr_FR": "",
          "it_IT": "",
          "de_DE": "",
          "es_ES": "",
          "pt_BR": "",
          "ko_KR": ""
