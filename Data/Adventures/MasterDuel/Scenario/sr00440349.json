      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "それは死の力に呑まれ、\nイドリースの尖兵へと堕ちた\nかつてのイムドゥーク――",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0044_TXT2026"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "「星遺物の守護竜メロダーク」であった。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0044_TXT2027"
      }
    },
