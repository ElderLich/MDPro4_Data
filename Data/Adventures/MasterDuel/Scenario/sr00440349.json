    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "ところが。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0044_TXT2014"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "機械人形に回帰した魂は、\n彼が待ち望んでいたモノではなかった。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0044_TXT2015"
      }
    },
