        "vol": -1
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "彼女が魅せた表情は\nかつてのイヴが見せた柔らかなものではなく、",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0044_TXT2016"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "口角を釣り上げてわらう邪悪な笑み――",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0044_TXT2017"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "イヴの魂と同化したままの\nリースのものであった。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0044_TXT2018"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "蘇ったリースは機械人形の主導権を奪い、\n“鍵”の力を行使――",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0044_TXT2019"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "――イヴの魂を消滅させる。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0044_TXT2020"
      }
    },
    {
      "command": "BgSet",
      "option": {
