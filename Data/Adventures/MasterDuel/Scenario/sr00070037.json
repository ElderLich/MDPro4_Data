    {
      "command": "Text",
      "option": {},
      "params": [
        0,
        0,
        "その星の支配者は人類ではなかった。",
        false
      ],
      "args": {
        "type": 0,
        "pos": 0,
        "text": "世界を巻き戻し、\r\nそこに生まれた生命の正常な発展を促す。",
        "textId": "IDS_SCENARIOGATE0007_TXT2007",
        "autominsec": 0
      }
