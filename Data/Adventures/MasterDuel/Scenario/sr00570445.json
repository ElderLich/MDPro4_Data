    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "竜騎士たちがワームを追い払うために\n先陣を切って飛翔する。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0057_TXT3014"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "その勇猛果敢な姿は\n霞の谷の者たちを鼓舞し、\n再び戦う気力を取り戻させた。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0057_TXT3015"
      }
    },
    {
      "command": "BgSet",
      "option": {
        "async": 1
      },
      "args": {
        "duration": 1,
        "path": "Scenarios/Gates/Gate057/Bg_Sr00570441_00",
        "oscale": 0,
        "color": "#FFFFFFFF",
        "pos": 8
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "程なくして谷に巣食う\nワームが排除される。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0057_TXT3016"
      }
    },
    {
      "command": "CardFadeOutAll",
      "option": {
        "async": 1
      },
      "args": {}
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "竜騎士たちは現れた時と同じように\n一陣の風となって去っていった。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0057_TXT3017"
      }
    },
    {
      "command": "BgSet",
      "option": {
