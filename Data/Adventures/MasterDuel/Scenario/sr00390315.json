      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "彼は御前試合での勝利を契機に、\n次代の六武衆となる人材の\n発掘・育成を任せられた。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0039_TXT3008"
