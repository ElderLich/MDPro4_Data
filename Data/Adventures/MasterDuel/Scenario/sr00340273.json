        "dstmrk": 7832
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "そうしてあらゆる状況に適応した\n新たな個体が誕生し、増殖する。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0034_TXT2004"
      }
    },
    {
      "command": "SoundPlay",
      "option": {},
      "args": {
