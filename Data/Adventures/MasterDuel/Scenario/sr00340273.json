    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "様々な攻撃を浴びつつも僅かに生き残ったワームは、\nそれを外的刺激としてさらなる進化を遂げていく。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0034_TXT2003"
      }
    },
    {
      "command": "SoundPlay",
      "option": {},
      "args": {
