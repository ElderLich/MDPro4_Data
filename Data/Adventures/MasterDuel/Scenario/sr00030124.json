    {
      "command": "Text",
      "option": {},
      "params": [
        0,
        0,
        "終わりの見えない戦いに誰もが消耗し、肩で息をしていた。",
        false
      ],
      "args": {
        "type": 0,
        "pos": 0,
        "text": "自身の中に眠るイヴにも\n継承権が残っていることを知ったイヴリースは、\nアウラムよりも先に星槍の力を手に入れようと飛び去った。",
        "textId": "IDS_SCENARIOGATE0003_TXT4004",
        "autominsec": 0
      }
    },
    {
      "command": "CardFadeOutAll",
      "option": {
        "async": 1
      },
      "args": {}
    },
    {
      "command": "Text",
      "option": {},
      "params": [
        0,
        0,
        "終わりの見えない戦いに誰もが消耗し、肩で息をしていた。",
        false
      ],
      "args": {
        "type": 0,
        "pos": 0,
        "text": "そうはさせまいと後を追うアウラム。",
        "textId": "IDS_SCENARIOGATE0003_TXT4005",
        "autominsec": 0
      }
    },
