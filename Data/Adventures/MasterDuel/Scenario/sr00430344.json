    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "暴走としか言えないほどの進化と破壊を続ける\nミュートリアたちの目を逃れるように、所員たちは、\n研究所を脱出するべく死に物狂いで通路を駆ける。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0043_TXT3011"
