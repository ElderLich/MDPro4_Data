        "pos": 0,
        "duration": 1
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『我々の研究の成果が……！\nだから危険だと言ったのだ！』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0043_TXT3008"
      }
    },
    {
      "command": "PrefabCreate",
      "option": {
        "async": 1
      },
      "args": {
        "label": "Hito2",
        "path": "Scenarios/Gates/Gate043/Pre_Sr00430344_01",
        "pos": 0,
        "duration": 1
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『なんて素晴らしい日なんだ！\nこの星の体系では起こりえないはずの進化の瞬間を、\nこの目で見届けることができるとは！』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0043_TXT3009"
      }
    },
    {
      "command": "PrefabCreate",
