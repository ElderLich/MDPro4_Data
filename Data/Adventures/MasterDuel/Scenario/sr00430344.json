    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "そうしている間にも、\nミュートリアたちの進化は\n次の段階へと進んでいた。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0043_TXT3012"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "「ミュートリア」同士が取り込み合い、\nそれぞれの進化の過程で得てきたものを集約。\nより巨大な生命体へと姿を変えていく。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0043_TXT3013"
      }
