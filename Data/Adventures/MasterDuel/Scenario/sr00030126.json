    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "幼なじみの少年が自分に向かって\n必死に何か叫んでいるのが見えた。",
        "textId": "IDS_SCENARIOGATE0003_TXT5017",
        "autominsec": 0
      }
