        false
      ],
      "args": {
        "type": 0,
        "pos": 0,
        "text": "その苛烈な攻撃の前に、\nアウラムは傷つき地に伏せてしまう。",
        "textId": "IDS_SCENARIOGATE0003_TXT5005",
        "autominsec": 0
