    {
      "command": "Text",
      "option": {},
      "params": [
        0,
        0,
        "その星の支配者は人類ではなかった。",
        false
      ],
      "args": {
        "type": 0,
        "pos": 0,
        "text": "「カラクリ解体新書」と呼ばれる書を\r\nご存じだろうか。",
        "textId": "IDS_SCENARIOGATE0011_TXT1001",
        "autominsec": 0
      }
    },
    {
      "command": "Text",
      "option": {},
      "params": [
        0,
        0,
        "その星の支配者は人類ではなかった。",
        false
      ],
      "args": {
        "type": 0,
        "pos": 0,
        "text": "「カラクリ」の仕組みがどうなっているか。\r\n「カラクリ」たちがどのように生まれたか。",
        "textId": "IDS_SCENARIOGATE0011_TXT1002",
        "autominsec": 0
      }
    },
    {
      "command": "Text",
      "option": {},
      "params": [
        0,
        0,
        "その星の支配者は人類ではなかった。",
        false
      ],
      "args": {
        "type": 0,
        "pos": 0,
        "text": "「カラクリ」を知るための全てが\r\nこの書に記されていると言っていい。",
        "textId": "IDS_SCENARIOGATE0011_TXT1003",
        "autominsec": 0
      }
    },
    {
      "command": "Text",
      "option": {},
      "params": [
        0,
        0,
        "その星の支配者は人類ではなかった。",
        false
      ],
      "args": {
        "type": 0,
        "pos": 0,
        "text": "それではさっそく、この書を紐解き、\r\n奥深い「カラクリ」の世界へ招待しよう。",
        "textId": "IDS_SCENARIOGATE0011_TXT1004",
        "autominsec": 0
      }
