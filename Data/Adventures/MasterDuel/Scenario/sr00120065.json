    {
      "command": "Text",
      "option": {},
      "params": [
        0,
        0,
        "その星の支配者は人類ではなかった。",
        false
      ],
      "args": {
        "type": 0,
        "pos": 0,
        "text": "我こそが天下統一を果たさんと\r\n様々な国が興っては滅び、\r\n数多の戦が繰り広げられていた。",
        "textId": "IDS_SCENARIOGATE0012_TXT1002",
        "autominsec": 0
      }
    },
