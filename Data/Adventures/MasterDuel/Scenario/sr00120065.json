    {
      "command": "Text",
      "option": {},
      "params": [
        0,
        0,
        "その星の支配者は人類ではなかった。",
        false
      ],
      "args": {
        "type": 0,
        "pos": 0,
        "text": "時は戦国、\r\n各地の英雄たちが、\r\n互いに勢力を振るって対立する時代。",
        "textId": "IDS_SCENARIOGATE0012_TXT1001",
        "autominsec": 0
