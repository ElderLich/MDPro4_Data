        false
      ],
      "args": {
        "type": 0,
        "pos": 0,
        "text": "妖は民衆を惑わし、\r\n時には有力者に取り入って\r\nさらなる戦を呼ぶこともあった。\r",
        "textId": "IDS_SCENARIOGATE0012_TXT1005",
        "autominsec": 0
