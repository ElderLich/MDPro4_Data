    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "一息つく間もなく、\n「ナチュル・ホーストニードル」たちの羽音が\n再度、森にこだます。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0053_TXT2014"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "ワームの大群が\n押し寄せてきたことを報せる伝令だ。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0053_TXT2015"
      }
    },
    {
      "command": "CardFadeIn",
      "option": {
        "async": 1
      },
      "args": {
        "mrk": 8119,
        "pos": 6,
        "se1": "SE_SOLO_DEGITAL_CARD_01",
        "mrk2": 0,
        "pos2": 2,
        "se2": "",
        "mrk3": 0,
        "pos3": 3,
        "se3": "",
        "mrk4": 0,
