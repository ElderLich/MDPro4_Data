        "tmlabel": "onp"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『たしかに、海は色んな危険が潜む\n超おっかねー場所だ。それでもオイラたちは陽気に\n海へと繰り出すんだよ！』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0032_TXT2015"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『それに、どんなにラクショーっぽい航海でも、\nキャプテンたちはマンガイチのための\n作戦を事前に用意してる。』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0032_TXT2016"
      }
    },
    {
      "command": "PrefabPlayLabeledTimeline",
