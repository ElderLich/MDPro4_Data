    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『ノリがワリィぜ兄弟！』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0032_TXT2014"
      }
    },
    {
      "command": "PrefabPlayLabeledTimeline",
      "option": {},
