    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『そろそろ進水式が始まるみてーだ。\nオイラたちも盛大に盛り上げないとな！』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0032_TXT2002"
