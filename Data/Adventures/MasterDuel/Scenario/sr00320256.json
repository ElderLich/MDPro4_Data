      "args": {
        "type": 0,
        "pos": 0,
        "text": "『……ん？　何だ？\n歌ってたら闇に\n紛れられねえんじゃないかって？』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0032_TXT2013"
