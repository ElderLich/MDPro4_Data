      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『仲間を大切にするキャプテンだからこそ、\nそういうところはしっかりやってんだよな。』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0032_TXT2017"
      }
