    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "そして、一つの大きな目的を成し遂げたヤマトの元に、\n盟友である二人の武神帝が姿を見せる。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0033_TXT3002"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "彼らは自分たちの動きが悟られぬよう。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0033_TXT3003"
      }
    },
    {
      "command": "SoundPlay",
      "option": {},
      "args": {
        "label": "SE_SOLO_WAFU_CARD_02",
        "vol": -1
