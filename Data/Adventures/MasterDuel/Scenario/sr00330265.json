    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "「武神帝－カグツチ」は「武神―ミカヅチ」として。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0033_TXT3004"
      }
    },
    {
      "command": "SoundPlay",
      "option": {},
