      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "「武神帝－ツクヨミ」は「武神―アラスダ」として。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0033_TXT3005"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "自らの力を封じ、さらに名を変え、\nヤマトを探すために地上世界へと降りてきたのだった。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0033_TXT3006"
      }
    },
    {
      "command": "CardFadeOutAll",
      "option": {
        "async": 0
      },
