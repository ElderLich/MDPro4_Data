      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "長い旅の末に五つの武神器を探し出したヤマトは、\nついに「武神帝－スサノヲ」としての力を取り戻す。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0033_TXT3001"
