      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 3,
        "text": "『……ロゼ』",
        "autominsec": 1,
        "textId": "IDS_SCENARIOGATE0071_TXT3027"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 3,
        "text": "本来なら無用な会話に\nロゼが応じたのも、時間稼ぎのためだ。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0071_TXT3028"
      }
    },
    {
      "command": "BgSet",
      "option": {
        "async": 1
      },
