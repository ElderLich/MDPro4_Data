    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 3,
        "text": "胸の奥から湧き出してくるモノに、ロゼは困惑する。",
        "autominsec": 2,
        "textId": "IDS_SCENARIOGATE0071_TXT3057"
      }
