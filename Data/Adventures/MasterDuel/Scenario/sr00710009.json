      "option": {},
      "args": {
        "type": 0,
        "pos": 3,
        "text": "『あなたも、本当は闘いたくないよね？』",
        "autominsec": 1,
        "textId": "IDS_SCENARIOGATE0071_TXT3045"
      }
    },
    {
