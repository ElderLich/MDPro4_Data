    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 3,
        "text": "『私はレイ。あなたは？』",
        "autominsec": 1,
        "textId": "IDS_SCENARIOGATE0071_TXT3025"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 3,
        "text": "レイの呼びかけに、黒の閃刀姫が\n絞り出すように口を開く。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0071_TXT3026"
      }
    },
    {
      "command": "BgSet",
      "option": {
        "async": 1
