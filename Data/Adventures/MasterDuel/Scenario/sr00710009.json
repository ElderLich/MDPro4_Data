        "textId": "IDS_SCENARIOGATE0071_TXT3055"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 3,
        "text": "何故、あそこで微笑んだのだろうか。",
        "autominsec": 2,
        "textId": "IDS_SCENARIOGATE0071_TXT3056"
      }
    },
    {
      "command": "BgPlayLabeledTimeline",
