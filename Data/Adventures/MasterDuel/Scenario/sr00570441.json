    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "そこに住むのは谷の合間を\n自由に行き来する鳥獣と、\nその身体に鳥の特徴を色濃く残した鳥人だ。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0057_TXT1003"
      }
    },
    {
      "command": "SoundPlay",
      "option": {},
      "args": {
