    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "そこに現れたのが、\n外なる星から飛来した「ワーム」である。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0057_TXT1022"
