    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "同族以外と殴り合えるのはいつ振りか。\n魔轟神たちは戦いの喜びに打ち震える。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0054_TXT2032"
