    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『こっちも準備は万端だ！\n留守番組総出で宴の準備も整ってるぜ！』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0032_TXT3003"
