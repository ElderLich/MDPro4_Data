    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "さて……今宵は少し長く\nしゃべりすぎたようだ。\n私はそろそろ眠るとしよう。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0040_TXT2014"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "まだ話し足りないなら、\n起きている者としてくれ。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0040_TXT2015"
      }
    },
