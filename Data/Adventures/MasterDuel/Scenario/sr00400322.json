    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『あれ？\nニンゲン？\nニンゲンがいるの？』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0040_TXT2017"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『アハハハハハハ！\nねえ、キミもボクたちと遊ばない？\nアハハハハハハハハハハ！』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0040_TXT2018"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
