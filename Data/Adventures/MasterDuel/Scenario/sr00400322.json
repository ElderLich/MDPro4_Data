    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "ん、なんだ？\n何か質問があるのか？",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0040_TXT2001"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "「ゴーストリック」の全員が\n洋館にいるかどうかだと？",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0040_TXT2002"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "いや、ほかの場所にもいるようだ。\n町の博物館に住んでいる者もいると\n聞いている。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0040_TXT2003"
      }
    },
    {
      "command": "BgPlayLabeledTimeline",
      "option": {},
      "args": {
        "label": "label_2"
      }
    },
