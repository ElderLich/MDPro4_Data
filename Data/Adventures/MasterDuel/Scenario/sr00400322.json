        "se4": ""
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "「デュラハン」や「マミー」なんかは、\n展示物に化けてジッとし、夜になったら、\nそこらへんをウロウロしているらしい。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0040_TXT2004"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "博物館には珍しいものが展示されてるから\n夜でも見物に来るニンゲンがいるようだ。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0040_TXT2005"
      }
    },
    {
      "command": "CardFadeOutAll",
      "option": {
        "async": 1
      },
      "args": {}
    },
    {
      "command": "BgSet",
      "option": {
        "async": 1
