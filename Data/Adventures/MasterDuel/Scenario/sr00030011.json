      }
    },
    {
      "command": "Text",
      "option": {},
      "params": [
        0,
        0,
        "司令塔が崩れ落ちるのと同時に、\n周囲一帯のアウラムたちを囲んでいた機怪蟲も動きを止めたのであった。",
        false
      ],
      "args": {
        "type": 0,
        "pos": 0,
        "text": "恐怖を感じたイヴは思わず悲鳴を上げようとしたが、\nそれすらも叶わず意識は深い闇に沈んでいった。",
        "textId": "IDS_SCENARIOGATE0003_TXT2015",
        "autominsec": 0
      }
