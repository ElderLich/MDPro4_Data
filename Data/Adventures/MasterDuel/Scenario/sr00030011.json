        "vol": -1
      }
    },
    {
      "command": "Text",
      "option": {},
      "params": [
        0,
        0,
        "エクスクローラーの抵抗は激しいものだったが、\n最後の力を振り絞ってそれを打ち倒す。",
        false
      ],
      "args": {
        "type": 0,
        "pos": 0,
        "text": "それが黒く、まがまがしく変貌していた。",
        "textId": "IDS_SCENARIOGATE0003_TXT2014",
        "autominsec": 3
      }
    },
    {
      "command": "ScreenFade",
      "option": {
        "async": 1
