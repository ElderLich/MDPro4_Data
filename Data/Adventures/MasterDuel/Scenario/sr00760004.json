        "se4": ""
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "炎の力と共に次の炎王へと生まれ変わるのだ。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0076_TXT2010"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "こうして炎を絶やすことなく、\n炎王たちは島を、神殿を守護してきた。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0076_TXT2011"
      }
    },
    {
      "command": "CardFadeOutAll",
      "option": {
