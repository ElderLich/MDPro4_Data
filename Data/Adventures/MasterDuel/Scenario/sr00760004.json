    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "しかし、その島にかつてないほどの\n大きな戦いが起きようとしていた。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0076_TXT2012"
