      "args": {
        "type": 0,
        "pos": 0,
        "text": "いざとなれば\n甲虫に搭乗していた歩兵部隊も\n戦闘に参加する。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0036_TXT1010"
