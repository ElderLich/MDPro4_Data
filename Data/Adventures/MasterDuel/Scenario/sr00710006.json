    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 3,
        "text": "様々な感情がレイに押し寄せる。",
        "autominsec": 2,
        "textId": "IDS_SCENARIOGATE0071_TXT2015"
      }
    },
    {
      "command": "BgPlayLabeledTimeline",
      "option": {},
      "args": {
        "label": "label_3"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 3,
        "text": "果たして自分は、この手であの少女に\nとどめを刺せるのか――？",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0071_TXT2016"
      }
    },
