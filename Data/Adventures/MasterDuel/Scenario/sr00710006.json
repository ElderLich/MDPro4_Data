    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 3,
        "text": "自身と互角、\nもしかするとそれ以上の力を持った閃刀姫――。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0071_TXT2013"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 3,
        "text": "今まで相手をしてきた機械ではない\n敵――。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0071_TXT2014"
      }
    },
    {
      "command": "BgPlayLabeledTimeline",
      "option": {},
      "args": {
