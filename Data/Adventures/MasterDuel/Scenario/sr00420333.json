    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『ジェネクスとワームが接触、\n戦いを始めた――。』と。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0042_TXT1015"
