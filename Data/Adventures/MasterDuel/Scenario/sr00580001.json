    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "日々変化していく敵に対し\nより戦闘向きで直接的な機能を備えた姿へと\n改修・進化していったのだ。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0058_C0001_TXT_003"
      }
