      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "一方のA・O・Jでも、\nより強力な兵器が求められていた。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0058_C0001_TXT_004"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "先の「W星雲隕石」を解析して得られたデータは、\nA・O・Jに様々な革新的技術をもたらしていた。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0058_C0001_TXT_005"
      }
    },
