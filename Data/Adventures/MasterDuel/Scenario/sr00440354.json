      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "群知能を有するクローラーを統合し、\n神の力の完全なる制御と行使を可能にする。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0044_TXT7007"
      }
    },
    {
      "command": "BgFade",
      "option": {
        "async": 1
      },
