    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "パラディオン、\n星遺物、\nそしてイヴ。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0044_TXT7001"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "幾度も幾度も自らの本性を\n潜ませ、隠し、\nついにリースは神の力へとたどり着いた。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0044_TXT7002"
      }
    },
    {
      "command": "BgSet",
      "option": {
        "async": 1
      },
      "args": {
        "duration": 2,
        "path": "Scenarios/Gates/Gate044/Bg_Sr00440350_05",
        "oscale": 0,
        "color": "#FFFFFFFF",
        "pos": 8
      }
    },
    {
      "command": "SoundPlayDetail",
      "option": {},
