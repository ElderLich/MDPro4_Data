      "option": {},
      "args": {
        "sec": 0.5
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "そのはずだったのだ。",
        "autominsec": 1,
        "textId": "IDS_SCENARIOGATE0044_TXT7008"
      }
    },
    {
      "command": "BgSet",
      "option": {
        "async": 1
      },
      "args": {
