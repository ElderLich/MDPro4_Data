    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "消えていくリースの残滓。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0044_TXT7014"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "残された強大な力の器。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0044_TXT7015"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "アウラムは継承者として\n選択を迫られる。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0044_TXT7016"
      }
    },
