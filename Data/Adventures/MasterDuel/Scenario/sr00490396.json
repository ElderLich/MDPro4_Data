    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "二人がこれまでに操ってきたどの龍脈とも異なる、\n強大な力を秘めた光の気「天威龍－アシュナ」が\n龍の姿となって現れた。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0049_TXT3018"
      }
    },
