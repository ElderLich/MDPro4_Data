    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "ううむ……。\n私は静かに、心穏やかに\n棺の中で寝ていたいのだが……。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0040_TXT1031"
      }
    },
