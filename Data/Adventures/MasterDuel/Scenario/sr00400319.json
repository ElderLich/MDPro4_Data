    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『ボクらが好きなのは\nニンゲンを驚かせるコト！』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0040_TXT1028"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『ビックリさせるためにいろんなしかけをしたり、\nみんなと遊んだりして、\nニンゲンが来るのを待ってるんだ！』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0040_TXT1029"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『むかしみたいに\nニンゲンがいっぱい\n遊びに来てくれたらうれしいな！』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0040_TXT1030"
      }
    },
