    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "あんまりうるさくされるのは、\n少々困るな。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0040_TXT1032"
