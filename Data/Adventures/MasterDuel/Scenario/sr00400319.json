    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "やれやれ、本当に騒がしいな。\n声が響いているではないか。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0040_TXT1021"
      }
    },
    {
      "command": "PrefabPlayLabeledTimeline",
      "option": {},
