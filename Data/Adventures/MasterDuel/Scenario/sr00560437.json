    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "「A（アーリー）・マインド」の成功を機に、\n敵の力を利用した兵器の開発は\n進められていった。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0056_TXT2001"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "我々はもっと「ワーム」を知らなければならない。\n外宇宙からもたらされる未知の物質が\n今以上に必要なのだ――。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0056_TXT2002"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "そうした方針が主軸となりつつあったため、\nワームの捕獲を目的とした兵器が\n続々と開発されるようになった。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0056_TXT2003"
      }
    },
    {
      "command": "PrefabDestroy",
      "option": {},
      "args": {
        "label": "Pre",
        "duration": 2
      }
    },
    {
      "command": "CardFadeIn",
      "option": {
        "async": 1
      },
      "args": {
        "mrk": 7963,
        "pos": 5,
        "se1": "SE_SOLO_DEGITAL_CARD_01",
        "mrk2": 0,
        "pos2": 2,
        "se2": "",
        "mrk3": 0,
        "pos3": 3,
        "se3": "",
        "mrk4": 0,
        "pos4": 4,
        "se4": ""
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "ワームの撃破を主目的としつつも、\n捕獲も可能な兵器。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0056_TXT2004"
      }
    },
    {
      "command": "CardFadeIn",
      "option": {
        "async": 1
      },
      "args": {
        "mrk": 0,
        "pos": 1,
        "se1": "SE_SOLO_DEGITAL_CARD_01",
        "mrk2": 7961,
        "pos2": 6,
        "se2": "",
        "mrk3": 0,
        "pos3": 3,
        "se3": "",
        "mrk4": 0,
        "pos4": 4,
        "se4": ""
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "捕獲のため、ワームを弱らせて\n無力化する兵器。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0056_TXT2005"
      }
    },
    {
      "command": "CardFadeOutAll",
      "option": {
        "async": 1
