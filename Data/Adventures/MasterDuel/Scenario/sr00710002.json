    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 3,
        "text": "歴史や戦術、そして閃刀という技術、\n同年代の少女が数年かけて理解するような\n情報を数日で理解していく。",
        "autominsec": 1,
        "textId": "IDS_SCENARIOGATE0071_TXT1009"
      }
