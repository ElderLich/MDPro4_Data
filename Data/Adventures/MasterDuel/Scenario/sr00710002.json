      "option": {},
      "args": {
        "type": 0,
        "pos": 3,
        "text": "その少女――「レイ」は\n開発者が目を見張る潜在能力を発揮。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0071_TXT1008"
      }
    },
