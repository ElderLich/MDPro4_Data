        "sec": 1,
        "skip": false
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 3,
        "text": "そんな中にあって、強大な軍事帝国に対抗するために\n開発された超兵器「閃刀（せんとう）」は、\n一人の少女に託された。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0071_TXT1007"
      }
    },
    {
      "command": "BgSet",
      "option": {
        "async": 1
