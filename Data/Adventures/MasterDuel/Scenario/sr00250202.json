      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "それは、チームの存在だ。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0025_TXT2005"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "勝利を手にするためには、\nチーム力を高める連携や、\nハプニングに対応する瞬時の判断力も求められる。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0025_TXT2006"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "それらの能力を持ったスター選手ほど\n様々なチームから熱烈なオファーがかかる。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0025_TXT2007"
      }
    },
