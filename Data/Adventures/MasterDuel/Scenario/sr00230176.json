    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "機怪蟲（クローラー）の群れが活動的だった地域。\nそして破壊された情報が多く残されている場所。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0023_TXT2002"
      }
