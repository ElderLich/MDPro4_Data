    {
      "command": "Text",
      "option": {},
      "params": [
        0,
        0,
        "星鎧を目の前にして、\nアウラムたちは機怪蟲の群れに行く手を阻まれてしまう。",
        false
      ],
      "args": {
        "type": 0,
        "pos": 0,
        "text": "美しい水のあふれる大河、\n様々な生き物が生息する森、\n煮えたぎるマグマを抱く火山……。",
        "textId": "IDS_SCENARIOGATE0014_TXT1001",
        "autominsec": 0
