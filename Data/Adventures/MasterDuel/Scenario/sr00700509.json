      "args": {
        "type": 0,
        "pos": 0,
        "text": "0時の針が過ぎる頃、\n月夜に照らされた影が二つ。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0070_TXT2001"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "多くの命が眠るこの墓場で、\n今宵も奇妙な会話が繰り広げられる。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0070_TXT2002"
      }
    },
    {
