    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "ゆらりゆらり。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0045_TXT2013"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "色とりどりに輝く\n雪の華に震える\nあなたの心。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0045_TXT2014"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "ちらりちらり。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0045_TXT2015"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "あなたの\n秘めたる想いは\n見えますか……？",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0045_TXT2016"
      }
