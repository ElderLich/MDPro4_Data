        "pos": 8
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "それからいくばくかの月日が流れた。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0028_TXT2014"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "平穏を取り戻した里では、\nネフティスを信奉する神事が執り行われている。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0028_TXT2015"
      }
