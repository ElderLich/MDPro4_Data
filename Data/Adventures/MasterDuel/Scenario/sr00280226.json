    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "突如として現れた強大な存在によって、\n里は激しい災禍に包まれたのだ。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0028_TXT2002"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "里を守るため、戦士たちが立ち向かった。",
