        "cnt": 1,
        "color": "#FF4747FF"
      }
    },
    {
      "command": "BgSet",
      "option": {
        "async": 1
      },
      "args": {
        "duration": 2,
        "path": "Scenarios/Gates/Gate037/Bg_Sr00370295_05",
        "oscale": 0.05,
        "color": "#FFFFFFFF",
        "pos": 8
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "洪水のようにフラッシュバックする生前の記憶。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0037_TXT1016"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "彼女は、かつて彼が愛した女性であった。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0037_TXT1017"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "愛する者を失った悲しみと喪失感。\nそして、彼女の命を奪ったヴェンデットへの憎しみ。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0037_TXT1018"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "濁流のようにうねる記憶の波は\n怨念の炎として燃え上がり、\n彼の心を紅く染め上げる。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0037_TXT1019"
      }
    },
    {
      "command": "SoundPlay",
      "option": {},
      "args": {
        "label": "SE_SOLO_EFFECT_13",
        "vol": -1
      }
    },
