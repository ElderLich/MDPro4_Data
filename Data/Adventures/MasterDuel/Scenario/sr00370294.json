    {
      "command": "BgPlayLabeledTimeline",
      "option": {},
      "args": {
        "label": "label_1"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "増える一方の生ける屍に対し、\n生者たちは根本的な解決策を見いだせていなかった。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0037_TXT1009"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "ついには急ごしらえで築いた壁を防衛線とし、\nかろうじてその生存圏を保つところまで\n追い詰められていたのだ。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0037_TXT1010"
      }
    },
    {
      "command": "BgWaitLabeledTimeline",
      "option": {},
      "args": {
        "skip": false
      }
    },
    {
      "command": "BgPlayLabeledTimeline",
      "option": {},
      "args": {
        "label": "label_4"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "その青年も、ヴェンデットによって\n命を落とした一人だった。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0037_TXT1011"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "彼は他のヴェンデットと同様、\n闇に包まれた街を徘徊する\n死者の一部となり果てていた。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0037_TXT1012"
      }
    },
    {
      "command": "BgFade",
      "option": {
        "async": 1
      },
      "args": {
        "duration": 1,
        "frm": "",
        "dst": "#5E6478FF"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "それは、全くの偶然だったのだろう。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0037_TXT1013"
      }
    },
    {
      "command": "BgSet",
      "option": {
        "async": 1
      },
      "args": {
        "duration": 2,
        "path": "Scenarios/Gates/Gate037/Bg_Sr00370295_04",
        "oscale": 0,
        "color": "#FFFFFFFF",
        "pos": 8
      }
    },
    {
