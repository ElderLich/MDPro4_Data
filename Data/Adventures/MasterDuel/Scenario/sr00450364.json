    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "ひらりひらり。\n軽やかに舞い踊る\n花びらのように。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0045_TXT1001"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "ふわりふわり。\n淑やかに風を流れる\n花びらのように。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0045_TXT1002"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "冷え冷えとした空を包む雲から、\nさめざめと下りる帳。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0045_TXT1003"
      }
    },
