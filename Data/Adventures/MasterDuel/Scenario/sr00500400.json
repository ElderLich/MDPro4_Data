      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "そして傭兵団に端を発する\n「X－セイバー」。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0050_TXT1007"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "ワームとの戦いが激化する中で\nX－セイバーは苦境に立たされていた。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0050_TXT1008"
      }
    },
