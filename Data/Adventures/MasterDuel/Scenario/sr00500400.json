      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "中には戦いで傷ついた身体を\n機械の義肢で補い、傷が癒えるのも待たずに\n戦いに臨む者もあった。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0050_TXT1011"
      }
    },
