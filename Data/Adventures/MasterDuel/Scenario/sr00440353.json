        "vol": -1
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "アウラムは\n無差別に襲い来る破壊の力を\n避け、防ぎ、中和。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0044_TXT6001"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "暴走する\n「星神器デミウルギア」へと\n迫っていく。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0044_TXT6002"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "内部へ突入し、\n引き寄せられるように\nその中枢へと辿り着いた。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0044_TXT6003"
      }
    },
    {
      "command": "SoundPlay",
      "option": {},
      "args": {
        "label": "SE_SOLO_HIKARI_04",
        "vol": -1
      }
    },
    {
