        "tmlabel": "label_1"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "リース、そして“鍵”。\nこれらが一つの発達し切った時代にそろってしまったのが\n全ての災厄の始まりだったのだ。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0044_TXT6015"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "さらに、アウラムに流れ込む思念と記憶。\nそれは、悪夢の如きリースの計画だった。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0044_TXT6016"
      }
    },
    {
      "command": "PrefabPlayLabeledTimeline",
      "option": {},
      "args": {
        "label": "Kagi",
        "tmlabel": "label_2"
      }
    },
    {
      "command": "BgSet",
      "option": {
        "async": 1
      },
      "args": {
        "duration": 2,
        "path": "Scenarios/Gates/Gate023/Bg_Sr00230178_04",
        "oscale": 0,
        "color": "#FFFFFFFF",
        "pos": 8
      }
    },
    {
      "command": "SoundPlay",
      "option": {},
      "args": {
        "label": "SE_SOLO_SUZU_02",
        "vol": -1
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "”神の力を我が手に。”",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0044_TXT6017"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "そのために必要なのは\n“鍵”の力の完全なる掌握。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0044_TXT6018"
      }
    },
