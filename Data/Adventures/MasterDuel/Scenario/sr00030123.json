    {
      "command": "Text",
      "option": {},
      "params": [
        0,
        0,
        "星鎧を目の前にして、\nアウラムたちは機怪蟲の群れに行く手を阻まれてしまう。",
        false
      ],
      "args": {
        "type": 0,
        "pos": 0,
        "text": "アウラムたちの戦いは続いていた。",
        "textId": "IDS_SCENARIOGATE0003_TXT3001",
        "autominsec": 0
      }
    },
    {
      "command": "SoundPlay",
      "option": {},
