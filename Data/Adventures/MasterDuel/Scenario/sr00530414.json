        "mrk": 8102,
        "pos": 1,
        "se1": "SE_SOLO_DEGITAL_CARD_01",
        "mrk2": 0,
        "pos2": 2,
        "se2": "",
        "mrk3": 0,
        "pos3": 3,
        "se3": "",
        "mrk4": 0,
        "pos4": 4,
        "se4": ""
      }
    },
    {
