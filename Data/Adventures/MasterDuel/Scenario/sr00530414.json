      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "外宇宙からの侵略者\n「ワーム」である。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0053_TXT1026"
      }
    },
