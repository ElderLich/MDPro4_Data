      }
    },
    {
      "command": "Text",
      "args": {
        "text": "こうして四つの部族が改めて手を組んだ計画は成功し\n「A（アーリー）・ジェネクス」が誕生した。",
        "textId": "IDS_SCENARIOGATE0058_C0008_TXT_013",
