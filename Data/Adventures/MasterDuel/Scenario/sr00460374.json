    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『次は「ラプスウェル」さん。』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0046_TXT2010"
      }
    },
    {
      "command": "PrefabPlayLabeledTimeline",
      "option": {},
      "args": {
        "label": "Chara00",
        "tmlabel": "face051"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『初めてお会いした時には\n空を飛んだり、ビームを出したりと\n色々驚きました。』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0046_TXT2011"
      }
    },
    {
      "command": "PrefabPlayLabeledTimeline",
      "option": {},
      "args": {
        "label": "Chara00",
        "tmlabel": "face001"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『でも、見た目と違って\nとても礼節を重んじる方なんです。』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0046_TXT2012"
      }
    },
    {
      "command": "PrefabPlayLabeledTimeline",
      "option": {},
      "args": {
        "label": "Chara00",
        "tmlabel": "face061"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『任務のことだけでなく、\n色々なことを\n丁寧に教えてくださいましたし。』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0046_TXT2013"
      }
    },
    {
      "command": "PrefabPlayLabeledTimeline",
      "option": {},
      "args": {
        "label": "Chara00",
        "tmlabel": "face001"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『「ジャスティファイ」司令官の次くらいに\n古くから「S－Force」にいるようで、\nどこか遠い次元から来たらしいです。』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0046_TXT2014"
      }
    },
