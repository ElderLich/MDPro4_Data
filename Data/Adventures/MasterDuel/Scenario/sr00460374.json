      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『そうそう、\n私がつけているこのメタルチャーム！』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0046_TXT2015"
      }
    },
    {
      "command": "PrefabPlayLabeledTimeline",
      "option": {},
      "args": {
        "label": "Chara00",
        "tmlabel": "face021"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『「ラプスウェル」さんが\n「基地の売店で売ってます」と\n教えてくれたんです。』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0046_TXT2016"
      }
    },
    {
      "command": "PrefabPlayLabeledTimeline",
      "option": {},
      "args": {
        "label": "Chara00",
        "tmlabel": "face011"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『私も真似して買ってしまいました。\nどうです？\n目立ちますし、カッコイイですよね？』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0046_TXT2017"
      }
    },
