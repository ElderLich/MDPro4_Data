      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『続いて「プロフェッサー」さん。\n科学部門を統括する凄い博士です。』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0046_TXT2018"
      }
    },
    {
      "command": "PrefabPlayLabeledTimeline",
      "option": {},
      "args": {
        "label": "Chara00",
        "tmlabel": "face001"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『任務をサポートする「ドッグ・タッグ」など、\nたくさんのメカや設備を開発しています。』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0046_TXT2019"
      }
    },
    {
      "command": "PrefabPlayLabeledTimeline",
      "option": {},
      "args": {
        "label": "Chara00",
        "tmlabel": "face011"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『さきほどの訓練施設も\n「プロフェッサー」さんが\nいつの間にか作っていた施設の１つですね。』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0046_TXT2020"
      }
    },
    {
      "command": "PrefabPlayLabeledTimeline",
      "option": {},
      "args": {
        "label": "Chara00",
        "tmlabel": "face101"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『ただ、他にも基地内を勝手に改造してるらしく、\n部屋の場所や通路の行き先が変わっていたりして、\n苦情が出ていることもあります。』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0046_TXT2021"
      }
    },
