    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『まずは、先ほどもお名前を出しましたが、\n「S－Force」の全ての作戦を決めている\n「ジャスティファイ」司令官です。』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0046_TXT2006"
      }
    },
    {
      "command": "PrefabPlayLabeledTimeline",
      "option": {},
      "args": {
        "label": "Chara00",
        "tmlabel": "face061"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『指令が下された時に、\nお声を聞くことはあるのですが……。』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0046_TXT2007"
      }
    },
    {
      "command": "PrefabPlayLabeledTimeline",
      "option": {},
      "args": {
        "label": "Chara00",
        "tmlabel": "face052"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『実は、\nお顔を見たことがないんです。』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0046_TXT2008"
      }
    },
    {
      "command": "PrefabPlayLabeledTimeline",
      "option": {},
      "args": {
        "label": "Chara00",
        "tmlabel": "face081"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『いつもあの重そうなスーツを\n着ておられるのでしょうか？\n……謎です。』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0046_TXT2009"
      }
    },
