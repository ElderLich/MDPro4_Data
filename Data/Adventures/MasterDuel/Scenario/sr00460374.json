      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『今ご紹介した先輩方は\nただ沢山の任務をこなしてる\nだけではないんです。』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0046_TXT2027"
      }
    },
    {
      "command": "PrefabPlayLabeledTimeline",
      "option": {},
      "args": {
        "label": "Chara00",
        "tmlabel": "face002"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『他の先輩方より\n多くのことを知った上で任務に\nあたっているようにも感じています。』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0046_TXT2028"
