      "args": {
        "type": 0,
        "pos": 0,
        "text": "その瞬間、輝きはさらに強さを増し、\n眩い閃光が辺りを埋め尽くす。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0044_TXT3007"
