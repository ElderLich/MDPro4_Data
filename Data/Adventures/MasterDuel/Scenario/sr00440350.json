    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "アウラムが屈しかけたその時、\nイドリースの前に\n一体の竜が飛来する。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0044_TXT3004"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "星辰の森から現れた\n「守護竜ユスティア」。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0044_TXT3005"
      }
    },
    {
      "command": "SoundPlay",
      "option": {},
      "args": {
        "label": "BGM_SOLO_32",
        "vol": -1
      }
    },
    {
      "command": "BgSet",
      "option": {
        "async": 1
      },
