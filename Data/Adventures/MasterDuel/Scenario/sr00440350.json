        "path": "Scenarios/Gates/Gate044/Bg_Sr00440350_02",
        "oscale": 0,
        "color": "#FFFFFFFF",
        "pos": 8
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "青い輝きを放つその竜は力を解放し\nイドリースに吸収されていた\nイヴの身体を引きはがした。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0044_TXT3006"
      }
    },
