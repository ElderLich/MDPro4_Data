    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『この部分は目か？\n金属のように硬質な部位や、\n人間の臓器のように軟質な部位をあわせ持っている。』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0043_TXT1010"
      }
    },
    {
      "command": "PrefabCreate",
      "option": {
        "async": 1
      },
      "args": {
        "label": "Hito2",
        "path": "Scenarios/Gates/Gate043/Pre_Sr00430344_01",
        "pos": 0,
        "duration": 1
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『部位ごとに構成物質に違いはあるが、\n有機体ではありそうだ。』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0043_TXT1011"
      }
    },
    {
      "command": "PrefabCreate",
      "option": {
        "async": 1
      },
      "args": {
        "label": "Hito3",
        "path": "Scenarios/Gates/Gate043/Pre_Sr00430344_02",
        "pos": 0,
        "duration": 1
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『これは……\n知性を有していると考えて\nよいのだろうか？』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0043_TXT1012"
      }
    },
    {
      "command": "PrefabDestroy",
