      "args": {
        "type": 0,
        "pos": 0,
        "text": "その日も、\nフィールド・マーシャルは戦場に立つ。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0055_TXT2012"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "そこは戦略図における重要な地点であり、\n数ある激戦区のひとつ。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0055_TXT2013"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "この日のワームの抵抗は\nいつになく苛烈であった。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0055_TXT2014"
      }
