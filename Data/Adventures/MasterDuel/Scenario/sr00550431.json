      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "ジェネクス・コントローラーが\n機体内部にたどり着くと、\nそこには横たわるスペア・ジェネクスの姿があった。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0055_TXT2027"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "機能停止まで\nもう数十秒といったところだろう。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0055_TXT2028"
      }
    },
    {
      "command": "BgSet",
      "option": {
        "async": 1
