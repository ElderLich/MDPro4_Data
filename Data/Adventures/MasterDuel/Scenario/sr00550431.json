    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "拠点での敗戦を覚悟していたA・O・Jであったが、\nかろうじて避けられたようだった。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0055_TXT2023"
      }
    },
    {
      "command": "BgMove",
      "option": {
