    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "しかし、その嫌悪を嗅ぎ取った\n「魔轟神レイヴン」の手に\nかかってしまう。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0057_TXT2023"
      }
    },
    {
      "command": "PrefabDestroy",
      "option": {},
      "args": {
        "label": "rei",
        "duration": 1
      }
    },
    {
