    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "太陽の紋様が昇る鏡に導かれた世界は\n光に満ちるきらびやかな地。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0024_TXT2002"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "そこは、自らも清らかな存在となり\n聖獣や光の騎士、乙女たちが生きる\n美しい世界です。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0024_TXT2003"
      }
    },
    {
      "command": "SoundPlay",
      "option": {},
      "args": {
        "label": "SE_SOLO_EFFECT_05",
        "vol": -1
      }
    },
    {
      "command": "ScreenFade",
      "option": {
        "async": 2
      },
      "args": {
        "duration": 1,
        "frmcolor": "",
        "dstcolor": "#FFFFFFFF",
        "target": 1
      }
    },
    {
