    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "来訪者は安堵の表情を浮かべ\n訪れた時とはいくらか正気を取り戻した様子で、\n占い師の前から去っていった。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0024_TXT2017"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "――もしかしたら、あなたが今宵見る夢も\n夢の支配者によって見せられた夢かもしれません。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0024_TXT2018"
      }
    },
