      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『まだ時間もありますし、\n次のお話を始める前に\n少し訓練をしていきましょう！』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0046_TXT1024"
      }
    },
