      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『「ジャスティファイ」司令官の作戦に基づき\n選出されたメンバーが\nワープゲートを使って出動します。』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0046_TXT1018"
      }
    },
    {
      "command": "PrefabPlayLabeledTimeline",
      "option": {},
      "args": {
        "label": "Chara00",
        "tmlabel": "face061"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『任務の内容は、\n災害への対応や人命救助。』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0046_TXT1019"
      }
    },
    {
      "command": "PrefabPlayLabeledTimeline",
      "option": {},
      "args": {
        "label": "Chara00",
        "tmlabel": "face001"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『犯罪などを未然に防ぐために必要な\n執行対象の追跡・捕獲など\n様々です。』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0046_TXT1020"
      }
    },
    {
      "command": "PrefabPlayLabeledTimeline",
      "option": {},
      "args": {
        "label": "Chara00",
        "tmlabel": "face051"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『いつ任務にあたることになるかは\n誰にもわかりません。』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0046_TXT1021"
      }
    },
    {
      "command": "PrefabPlayLabeledTimeline",
      "option": {},
      "args": {
        "label": "Chara00",
        "tmlabel": "face072"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『だからこそ、\nいつでも出動できるよう\n鍛えて準備しておくことが大事なんです。』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0046_TXT1022"
      }
