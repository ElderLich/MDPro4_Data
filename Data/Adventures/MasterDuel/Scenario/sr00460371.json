    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『私たちの基地である、\nこの「ブリッジヘッド」では、\n多くの次元・時間を観測しています。』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0046_TXT1016"
      }
    },
    {
      "command": "PrefabPlayLabeledTimeline",
      "option": {},
      "args": {
        "label": "Chara00",
        "tmlabel": "face001"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『観測の結果、\n対応しなければならない問題が見つかった時に、\n任務にあたります。』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0046_TXT1017"
      }
    },
