      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『新人エージェントの皆さん！\n「S－Force」へようこそ！』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0046_TXT1005"
      }
    },
    {
      "command": "PrefabPlayLabeledTimeline",
      "option": {},
      "args": {
        "label": "Chara00",
        "tmlabel": "face001"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『任務にあたる前に、\n私たちの組織について理解を深めてもらうため、\nこの場が用意されました。』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0046_TXT1006"
      }
    },
    {
      "command": "PrefabPlayLabeledTimeline",
      "option": {},
      "args": {
        "label": "Chara00",
        "tmlabel": "face022"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『私が本日の案内役\n「乱破小夜丸(らっぱちよまる)」です。\n宜しくお願いします。』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0046_TXT1007"
      }
    },
    {
      "command": "PrefabPlayLabeledTimeline",
      "option": {},
      "args": {
        "label": "Chara00",
        "tmlabel": "face001"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『本日ここに集まっている皆さんも、\nエージェントになった経緯は\n様々だと思います。』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0046_TXT1008"
      }
    },
    {
      "command": "PrefabPlayLabeledTimeline",
      "option": {},
      "args": {
        "label": "Chara00",
        "tmlabel": "face061"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『何らかの事件に巻き込まれたり、\nスカウトされたり。』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0046_TXT1009"
      }
    },
    {
      "command": "PrefabPlayLabeledTimeline",
      "option": {},
      "args": {
        "label": "Chara00",
        "tmlabel": "face061"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『自分のしたい事と、\n「S－Force」の活動目的が\n一致していたり……。』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0046_TXT1010"
      }
    },
    {
      "command": "PrefabPlayLabeledTimeline",
      "option": {},
      "args": {
        "label": "Chara00",
        "tmlabel": "face072"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『組織間の盟約に\n従っている人も\nいるかもしれません。』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0046_TXT1011"
      }
    },
    {
      "command": "PrefabPlayLabeledTimeline",
      "option": {},
      "args": {
        "label": "Chara00",
        "tmlabel": "face022"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『私は、里長からの命を受けて、\nこちらに身を置くことになりました。』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0046_TXT1012"
      }
    },
