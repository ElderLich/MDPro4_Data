    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "行くあても、カネも何もなく、\nボロボロの姿で街を彷徨うゴブリン。\n『ハラ、減ったなぁ。』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0077_TXT2018"
      }
    },
    {
