      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "死者に脅かされ続けた長い夜が終わり、\n生き残った人々に平穏な日々が戻った。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0037_TXT5013"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "それでも、多くの命が失われた悲しみは癒えず、\n夜が訪れる度にかつての悪夢に怯える者も少なくない。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0037_TXT5014"
      }
    },
    {
      "command": "BgSet",
      "option": {
        "async": 1
      },
      "args": {
        "duration": 4,
        "path": "Scenarios/Gates/Gate037/Bg_Sr00370301_02",
