    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "アウラムはイヴリースと\n対峙した時と同じ光景――",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0044_TXT1004"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "その時とは比較にならぬほどの\n強い輝きを目にする。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0044_TXT1005"
      }
