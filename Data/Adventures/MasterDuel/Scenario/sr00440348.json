    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "凄まじい破壊の暴風は過ぎ去り、\n防壁が消滅する。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0044_TXT1007"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "イムドゥークの生命そのものを\n燃焼させた護りにより、\nパラディオンの面々は無事であった。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0044_TXT1008"
