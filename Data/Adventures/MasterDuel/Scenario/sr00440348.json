      "args": {
        "type": 0,
        "pos": 0,
        "text": "イムドゥークが\n神の眷属たる力を発現させ、\n巨大な防壁を展開したのだ。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0044_TXT1006"
      }
    },
    {
      "command": "BgMove",
      "option": {
        "async": 1
