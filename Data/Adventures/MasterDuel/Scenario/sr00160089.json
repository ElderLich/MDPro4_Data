        0,
        "その星の支配者は人類ではなかった。",
        false
      ],
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『 ……ママ、どうして雨なんて降るの？』",
        "textId": "IDS_SCENARIOGATE0016_TXT1006",
        "autominsec": 0
      }
    },
    {
      "command": "Text",
      "option": {},
