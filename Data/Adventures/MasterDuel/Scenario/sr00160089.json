        false
      ],
      "args": {
        "type": 0,
        "pos": 0,
        "text": "“空に絵を描く”という表現が気に入ったのだろうか。",
        "textId": "IDS_SCENARIOGATE0016_TXT1013",
        "autominsec": 0
      }
    },
