        0,
        "その星の支配者は人類ではなかった。",
        false
      ],
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『その絵が天気になって、\r\nみんなにたくさんの恵みをくれるの。』",
        "textId": "IDS_SCENARIOGATE0016_TXT1012",
        "autominsec": 0
