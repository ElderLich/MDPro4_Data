    {
      "command": "Text",
      "args": {
        "text": "しかし、その隙を突くように、\n多数の悪魔が一斉に襲いかかってきた。",
        "textId": "IDS_SCENARIOGATE0081_C0002_TXT_012",
        "chain_text": false,
        "type": 0,
        "pos": 0,
        "autominsec": 0
      }
    },
    {
      "command": "Text",
      "args": {
        "text": "真名を明かそうにも、\n激しい攻撃に、防戦一方となる二人。",
        "textId": "IDS_SCENARIOGATE0081_C0002_TXT_013",
        "chain_text": false,
