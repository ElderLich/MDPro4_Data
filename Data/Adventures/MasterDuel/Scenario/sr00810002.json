        "chara_icon_actor_ctrls": [],
        "chara_name": "ソフィア",
        "chara_name_id": "IDS_SCENARIOGATE0081_TALKER_001"
      }
    },
    {
      "command": "Talk",
      "args": {
        "text": "逃がさないわよ！",
        "textId": "IDS_SCENARIOGATE0081_C0002_TXT_TALK_010",
        "chain_text": false,
        "type": 0,
        "pos": 0,
        "autominsec": 0,
