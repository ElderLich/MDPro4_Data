        "chara_name": "ソフィア",
        "chara_name_id": "IDS_SCENARIOGATE0081_TALKER_001"
      }
    },
    {
      "command": "Talk",
      "args": {
        "text": "ソフィアちゃん、この姿って――",
        "textId": "IDS_SCENARIOGATE0081_C0002_TXT_TALK_005",
        "chain_text": false,
        "type": 0,
        "pos": 0,
        "autominsec": 0,
        "chara_icon": "Scenarios/Gates/Gate081/<_CARD_ILLUST_>/Icon/Swap/Ico_Sr00810002_ire_normal",
