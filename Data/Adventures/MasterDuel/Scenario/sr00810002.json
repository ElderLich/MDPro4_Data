    {
      "command": "Text",
      "args": {
        "text": "悪魔の真名を突き止めた二人は、\n悪魔怪人を囲い込むと、\nその名を唱えた。",
        "textId": "IDS_SCENARIOGATE0081_C0002_TXT_007",
        "chain_text": false,
        "type": 0,
        "pos": 0,
        "autominsec": 0
      }
    },
    {
      "command": "Text",
      "args": {
        "text": "苦痛から逃れようと暴れる身体を、\n聖武具の力で押さえ込む二人。",
        "textId": "IDS_SCENARIOGATE0081_C0002_TXT_008",
        "chain_text": false,
        "type": 0,
        "pos": 0,
        "autominsec": 0
      }
    },
    {
      "command": "Talk",
      "args": {
        "text": "……っ、もう少しです。",
        "textId": "IDS_SCENARIOGATE0081_C0002_TXT_TALK_009",
        "chain_text": false,
        "type": 0,
        "pos": 0,
        "autominsec": 0,
        "chara_icon": "Scenarios/Gates/Gate081/<_CARD_ILLUST_>/Icon/Swap/Ico_Sr00810002_sof_sad",
