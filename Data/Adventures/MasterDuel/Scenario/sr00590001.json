      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『だってそうでしょ？\nぶっちゃけた話、\nボクらフレムベルが最強だと思わない？』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0059_TXT1022"
