      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『あーあ、ワームなんてのが出てこなければ、\nボクたちが大陸を制覇してたんだろうになー。\nいやーざんねんざんねん。』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0059_TXT1021"
      }
    },
