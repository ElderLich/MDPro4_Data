        "vol": -1
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『こ、このあたりじゃ見ないやつだな……。\n道に迷ったのか？』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0059_TXT1004"
      }
    },
    {
      "command": "BgPlayLabeledTimeline",
      "option": {},
      "args": {
        "label": "label_4"
      }
    },
    {
      "command": "SoundPlay",
      "option": {},
      "args": {
        "label": "SE_SOLO_FC_03",
        "vol": -1
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『んー……そっかー……。\n多分そうなんだよな……。\nここまで来るヤツなんて滅多にいないしな。』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0059_TXT1005"
      }
    },
    {
      "command": "BgPlayLabeledTimeline",
      "option": {},
