        "vol": -1
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『よし！　じゃあ、道案内がてら\nボクら「フレムベル」戦士団のことでも話してやろっか！\n付いてきなよ！』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0059_TXT1006"
      }
    },
