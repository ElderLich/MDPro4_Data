        "vol": -1
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『あれ？　「フレムベル」が\n手を焼くってのもヘンな話だな。\nアハハハハ！』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0059_TXT1020"
