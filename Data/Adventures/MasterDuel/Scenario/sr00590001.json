      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『さすがのボクらでも手を焼くよ。』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0059_TXT1019"
      }
    },
    {
      "command": "PrefabPlayLabeledTimeline",
      "option": {},
