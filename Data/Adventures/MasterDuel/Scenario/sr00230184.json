    {
      "command": "Text",
      "option": {},
      "params": [
        0,
        0,
        "世界は機界騎士（ジャックナイツ）と呼ばれる七騎の機械生命体によって統治されていた。",
        false
      ],
      "args": {
        "type": 0,
        "pos": 0,
