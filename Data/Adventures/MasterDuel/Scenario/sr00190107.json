        false
      ],
      "args": {
        "type": 0,
        "pos": 0,
        "text": "その地方に住む人々の中には\n「宣告者（デクレアラー）」を見たり、\n 声を聞いたりした者が少数ながら存在する。",
        "textId": "IDS_SCENARIOGATE0019_TXT1005",
        "autominsec": 0
      }
    },
