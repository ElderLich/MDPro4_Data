        "pos4": 4,
        "se1": "SE_SOLO_DEGITAL_CARD_01",
        "se2": "",
        "se3": "",
        "se4": ""
      }
    },
    {
      "command": "Text",
      "option": {},
      "params": [
        0,
        0,
        "その星の支配者は人類ではなかった。",
        false
      ],
      "args": {
        "type": 0,
        "pos": 0,
        "text": "また、声を聞いたという者が言うには、\n実際に音として聞こえたのではない。",
        "textId": "IDS_SCENARIOGATE0019_TXT1008",
        "autominsec": 0
      }
    },
    {
      "command": "CardFadeIn",
      "option": {
        "async": 1
      },
