    {
      "command": "Text",
      "option": {},
      "params": [
        0,
        0,
        "その星の支配者は人類ではなかった。",
        false
      ],
      "args": {
        "type": 0,
        "pos": 0,
        "text": "身にまとう雰囲気、後光は、\n自分が心に思い描いていた\n天使そのものであったと語るのだ。",
        "textId": "IDS_SCENARIOGATE0019_TXT1007",
        "autominsec": 0
      }
    },
