    {
      "command": "Text",
      "option": {},
      "params": [
        0,
        0,
        "その星の支配者は人類ではなかった。",
        false
      ],
      "args": {
        "type": 0,
        "pos": 0,
        "text": "その神こそ翼を広げ、\n全身から鮮やかな光を放つ御霊――\n「宣告者（デクレアラー）」である。",
        "textId": "IDS_SCENARIOGATE0019_TXT1004",
        "autominsec": 0
      }
