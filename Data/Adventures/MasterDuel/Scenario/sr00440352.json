    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "邪悪な意志に感応した\nデミウルギアは暴走を始める。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0044_TXT5021"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "その強大な神の力は漏れ出す余波だけで\n星の破壊を加速させていった。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0044_TXT5022"
      }
    },
    {
      "command": "BgSet",
      "option": {
        "async": 1
      },
