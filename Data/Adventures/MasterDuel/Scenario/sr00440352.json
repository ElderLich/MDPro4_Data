    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "さらにニンギルスは自身の全力を振り絞り\n最大最後の錬成を行う。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0044_TXT5013"
      }
