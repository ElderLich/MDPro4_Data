        "vol": -2000,
        "fade": -1,
        "pan": -2000,
        "pitch": -2000,
        "delay": -1,
        "ignoreSkip": true
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "それは、神となって再誕したイヴを\n守り続けるために用意していた姿。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0044_TXT5014"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "全ての「オルフェゴール」、\nそして自らをも組み込んだ巨神――\n「宵星の機神(シーオルフェゴール）ディンギルス」であった。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0044_TXT5015"
      }
    },
    {
      "command": "BgSet",
      "option": {
        "async": 1
