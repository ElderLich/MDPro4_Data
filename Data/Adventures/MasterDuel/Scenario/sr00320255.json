    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『お次は団の中でも有名な三人を紹介すっかな！』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0032_TXT1014"
      }
    },
    {
      "command": "PrefabDestroy",
      "option": {},
      "args": {
