      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『最後は海技士の青髭さんで、\n団きっての技術屋だ。』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0032_TXT1022"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『いっつも船の設計をしてっけど、\n聞いたハナシじゃそれ以外にもいろいろ作れるらしい。』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0032_TXT1023"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『何か作ってほしいモンがあるってんなら、\nこの人に頼めば間違いねえハズだぜ。』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0032_TXT1024"
      }
    },
