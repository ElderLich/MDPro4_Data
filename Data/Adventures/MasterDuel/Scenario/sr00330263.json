    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "この世界は象徴たる姫神・ヒルメを中心とする\n神々によって治められていた。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0033_TXT1002"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "彼女は三種の武神器――",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0033_TXT1003"
      }
    },
    {
      "command": "PrefabDestroy",
