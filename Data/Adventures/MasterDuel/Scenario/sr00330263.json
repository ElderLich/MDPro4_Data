        "se4": ""
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "「武神器－ムラクモ」「武神器－ヤタ」\n「武神器－ヤサカニ」をまとって\n真なる力を発揮し、最高神・アマテラスとなる。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0033_TXT1004"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "強大な力を持つ彼女は、\n天上世界だけではなく\n人間たちの住む地上をも統治していた。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0033_TXT1005"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "彼女は世界を守護するにあたり、\n出過ぎた介入はしなかった。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0033_TXT1006"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "太陽のごとき慈愛で天上と地上の世界を見守り、\n大きな災いが訪れた時のみ神の力を振るった。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0033_TXT1007"
      }
    },
    {
      "command": "CardFadeOutAll",
      "option": {
        "async": 1
      },
      "args": {}
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "そして、ヒルメは特に信頼の厚い三人の武神帝に\n自らの武神器を貸し与え、\n神々の目が届きにくい地上を守護する役目を託した。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0033_TXT1008"
      }
    },
    {
      "command": "CardFadeIn",
      "option": {
        "async": 1
      },
      "args": {
        "mrk": 10660,
        "pos": 5,
        "se1": "SE_SOLO_WAFU_CARD_01",
        "mrk2": 0,
        "pos2": 2,
        "se2": "",
        "mrk3": 0,
        "pos3": 3,
        "se3": "",
        "mrk4": 0,
        "pos4": 4,
        "se4": ""
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "一人は、\n二振りの神剣・ムラクモとハバキリを手に、\n姫神を守る役目を担う「武神帝－スサノヲ」。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0033_TXT1009"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "武術に長け、\n三人の中でも最も猛々しい武神帝だ。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0033_TXT1010"
      }
    },
    {
      "command": "CardFadeOut",
      "option": {
        "async": 1
      },
