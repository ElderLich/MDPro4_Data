    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "善悪を問わず、\n多くの神々が暮らす\n天上世界・高天原(タカマガハラ）。",
        "autominsec": 0,
