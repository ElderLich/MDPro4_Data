      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "そして、絶対神「魔轟神レヴュアタン」が\n頂点として君臨していた。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0054_TXT1012"
      }
