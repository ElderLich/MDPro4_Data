      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "第一位の王「魔轟神ヴァルキュルス」\n第二位の王「魔轟神レイジオン」",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0054_TXT1011"
      }
    },
    {
