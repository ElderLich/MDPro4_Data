    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "彼らは「U.A.（ウルトラアスリート）」と呼ばれ、\nさまざまな競技で活躍する。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0025_TXT1003"
