    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "『うぎゃぁぁあああ！\nウ、ウソだと言ってくれー！』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0077_TXT1011"
      }
