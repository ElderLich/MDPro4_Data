    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "ゴブリンの会社もバブル崩壊のアオリを受け倒産。\n『オ、オレ様の会社がぁぁぁぁああ！　オーマイガッ!!』",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0077_TXT1006"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "後に残ったのは多くの債務だけ。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0077_TXT1007"
      }
    },
    {
