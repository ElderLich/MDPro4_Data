    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "そして、スレイヤーの身は、\n「リヴェンデット・エグゼクター」として\nより強大な力を持った姿へと覚醒する。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0037_TXT4019"
      }
