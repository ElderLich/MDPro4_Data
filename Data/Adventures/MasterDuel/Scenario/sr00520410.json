        "vol": -1
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "「男」は、\nその傭兵の中の一人であった。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0052_TXT2011"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "静かで寡黙であったが、強靭な武力を持ち、\nその瞳の奥には確固たる\n自我の光が鋭く灯っていた。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0052_TXT2012"
      }
    },
    {
      "command": "PrefabDestroy",
      "option": {},
      "args": {
        "label": "Man",
        "duration": 3
      }
    },
    {
      "command": "CardFadeIn",
      "option": {
        "async": 1
      },
      "args": {
        "mrk": 15128,
        "pos": 1,
        "se1": "SE_SOLO_DEGITAL_CARD_01",
