      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "「男」は島に巣食う獣や、\n呪いを浴びた成れ果ての亡者たち。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0052_TXT2013"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "絶え間なく襲い来るそれらを、\nただひたすらに、黙々と、\n斬り伏せながら進んでゆく。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0052_TXT2014"
      }
    },
