    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "この日、「黄金卿エルドリッチ」が\n世に生まれ落ちる。",
        "autominsec": 3,
        "textId": "IDS_SCENARIOGATE0052_TXT2026"
      }
    },
    {
      "command": "BgSet",
      "option": {
        "async": 1
