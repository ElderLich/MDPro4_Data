      "args": {
        "type": 0,
        "pos": 0,
        "text": "城の中に生き物の気配はない。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0052_TXT2018"
      }
    },
    {
      "command": "ScreenFade",
      "option": {
