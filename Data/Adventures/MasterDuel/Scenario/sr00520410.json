        "dst": "#FFFFFFFF"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "地下へとたどり着いた「男」は、\n宙に浮き、禍々しく輝く紅い魔石を見た。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0052_TXT2019"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "「男」には錬金術に関する知識はない。\nそれでも、それを見ただけで\nこれがこの島を覆う呪いの元凶であると理解した。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0052_TXT2020"
      }
    },
    {
      "command": "BgPlayLabeledTimeline",
      "option": {},
      "args": {
        "label": "label_2"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "「男」は魔石に手を伸ばし、\n触れた。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0052_TXT2021"
      }
    },
    {
      "command": "BgPlayLabeledTimeline",
      "option": {},
