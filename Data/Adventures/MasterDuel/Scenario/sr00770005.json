    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "そんなゴブリンも、たまの休みには家のお手入れ。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0077_TXT3019"
      }
    },
    {
      "command": "Text",
      "option": {},
      "args": {
        "type": 0,
        "pos": 0,
        "text": "のびきった雑草をとったり、家に侵入してくる獣を\n追い払って過ごしていた。",
        "autominsec": 0,
        "textId": "IDS_SCENARIOGATE0077_TXT3020"
      }
    },
