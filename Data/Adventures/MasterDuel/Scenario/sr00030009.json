    {
      "command": "Text",
      "option": {},
      "params": [
        0,
        0,
        "司令塔が崩れ落ちるのと同時に、\n周囲一帯のアウラムたちを囲んでいた機怪蟲も動きを止めたのであった。",
        false
      ],
      "args": {
        "type": 0,
        "pos": 0,
        "text": "アウラムたちの前に\n一騎、また一騎と、\n機界騎士（ジャックナイツ)が駆けつける。",
        "textId": "IDS_SCENARIOGATE0003_TXT1013",
        "autominsec": 0
      }
    },
    {
      "command": "SoundPlay",
      "option": {},
      "args": {
