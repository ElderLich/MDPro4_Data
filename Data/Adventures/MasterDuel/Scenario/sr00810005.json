    },
    {
      "command": "Talk",
      "args": {
        "text": "（ステラと一緒なら、どんな強敵とだって戦える。）",
        "textId": "IDS_SCENARIOGATE0081_C0005_TXT_TALK_036",
        "chain_text": false,
        "type": 0,
        "pos": 0,
        "autominsec": 0,
        "chara_icon": "Scenarios/Gates/Gate081/<_CARD_ILLUST_>/Icon/Swap/Ico_Sr00810002_eri_normal",
        "chara_icon_label": "C04",
        "chara_icon_actor_ctrls": [],
        "chara_name": "エリス",
        "chara_name_id": "IDS_SCENARIOGATE0081_TALKER_004"
      }
    },
    {
      "command": "Talk",
      "args": {
        "text": "（お姉さまが夢見ていた、\n平和な世界を――必ず実現するんだ。）",
        "textId": "IDS_SCENARIOGATE0081_C0005_TXT_TALK_037",
        "chain_text": false,
        "type": 0,
        "pos": 0,
        "autominsec": 0,
