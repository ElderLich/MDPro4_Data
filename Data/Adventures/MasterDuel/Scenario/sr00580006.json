        "vol": -1
      }
    },
    {
      "command": "Text",
      "args": {
        "text": "それでも足らず、各部族の戦士たちも総動員で\nディサイシブ・アームズの防衛に回った。",
        "textId": "IDS_SCENARIOGATE0058_C0006_TXT_018",
        "type": 0,
        "pos": 0,
        "autominsec": 0
      }
    },
