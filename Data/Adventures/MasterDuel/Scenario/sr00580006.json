        "async": 1
      },
      "args": {
        "duration": 0.2,
        "frmcolor": "",
        "dstcolor": "#FFFFFFFF",
        "target": 1
      }
    },
    {
      "command": "Text",
      "args": {
        "text": "再び実体化したゼロに突き刺さったのは、\n第一射に倍する光と熱を持った砲撃だった。",
        "textId": "IDS_SCENARIOGATE0058_C0006_TXT_025",
        "type": 0,
        "pos": 0,
        "autominsec": 0
